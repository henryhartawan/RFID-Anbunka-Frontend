@{
    ViewData["Title"] = "Parameter Recovery Special CT";
    string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<div class="page-main">
    <div class="page-content padding-10">
        <div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
    </div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="padding-top:25vh;">
    <div class="" role="document" style="padding-left:25vw;">
        <div class="modal-content" style="width:50vw">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="myModalTitle">Upload Parameter Recovery Special CT</h4>
            </div>
            <div class="modal-body margin-bottom-0 padding-bottom-0">
                <form id="formUpload" enctype="multipart/form-data" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 control-label" style="text-align:left;">Periode</label>
                        <div class="col-sm-9">
                            <input type="text" id="PeriodeUpload" style="width: 100%;" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label" style="text-align:left;">File Excel</label>
                        <div class="col-sm-9">
                            <input type="file" name="file" id="fileUpload" accept=".xls,.xlsx" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-12">
                            <span>Download template <a href="#" id="btnDownloadTemplate" style="color:#0099ff">here</a></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id='clear'>Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveUpload">Upload</button>
            </div>
        </div>
    </div>
</div>

<script>
    var AppD = {
        attachEvents: function () {
            var o = this;
            o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));
            o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
            o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
            o.dom.$editorUpload.on('click', '#btnDownloadTemplate', o.eventHandlers.onClickBtnDownloadTemplate.bind(o));
        },
        cacheDom: function () {
            var o = this;
            o.dom.$grid = $("#grid");
            o.dom.$editorUpload = $("#editorUpload");
            o.dom.$btnSaveUpload = $("#btnSaveUpload");
        },
        data: {
            UploadDate: new Date()
        },
        dom: {},
        generateGrid: function() {
            var o = this;
            var selectedDate = o.data.UploadDate;
            var year = selectedDate.getFullYear();
            var month = selectedDate.getMonth();
            var daysInMonth = new Date(year, month + 1, 0).getDate();

            var columns = [
                { field: "LineCode", title: "Line", width: 90, locked: true },
                { field: "Parameter", title: "Parameter", width: 150, locked: true }
            ];

            var modelFields = {
                LineCode: { type: "string" },
                Parameter: { type: "string" }
            };

            for (var i = 1; i <= daysInMonth; i++) {
                var dStr = kendo.toString(new Date(year, month, i), "dd-MMM");
                var fieldName = "D" + i;

                columns.push({
                    field: fieldName,
                    title: dStr,
                    width: 80,
                    attributes: { style: "text-align: right;" },
                    template: "#= " + fieldName + " == null || " + fieldName + " == 0 ? '-' : kendo.toString(" + fieldName + ", 'n2') #"
                });
                modelFields[fieldName] = { type: "number" };
            }

            if (o.dom.$grid.data("kendoGrid")) {
                o.dom.$grid.data("kendoGrid").destroy();
                o.dom.$grid.empty();
            }

            o.dom.$grid.kendoGrid({
                excel: { fileName: "Adjustment_Plan_" + kendo.toString(selectedDate, "yyyy_MM") + ".xlsx", allPages: true },
                dataSource: {
                    transport: {
                        read: function (options) {
                            $.ajax({
                                method: 'post',
                                headers: { 'Content-Type': 'application/json' },
                                url: "@myurl" + 'ParameterRecoverySct/INQ',
                                dataType: 'text',
                                data: JSON.stringify({
                                    Periode: kendo.toString(o.data.UploadDate, 'yyyy-MM')
                                })
                            }).done(function (data) {
                                try {
                                    var rawResult = JSON.parse(data);

                                    var grouped = {};
                                    rawResult.forEach(function(item) {
                                        if (!grouped[item.LineCode]) grouped[item.LineCode] = [];
                                        grouped[item.LineCode].push(item);
                                    });

                                    var pivotedResult = [];
                                    for (var line in grouped) {
                                        var sctRow = { LineCode: line, Parameter: "Special Cycle Time" };
                                        var recDayRow = { LineCode: line, Parameter: "Recovery Day" };
                                        var recNightRow = { LineCode: line, Parameter: "Recovery Night" };

                                        for(var d=1; d<=daysInMonth; d++){
                                            sctRow["D"+d] = null;
                                            recDayRow["D"+d] = 0;
                                            recNightRow["D"+d] = 0;
                                        }

                                        grouped[line].forEach(function(item) {
                                            var dateObj = new Date(item.TargetDate);
                                            var dayStr = "D" + dateObj.getDate();

                                            if(item.SpecialCycleTime !== null) sctRow[dayStr] = item.SpecialCycleTime;
                                            if(item.RecoveryDay > 0) recDayRow[dayStr] = item.RecoveryDay;
                                            if(item.RecoveryNight > 0) recNightRow[dayStr] = item.RecoveryNight;
                                        });

                                        pivotedResult.push(sctRow, recDayRow, recNightRow);
                                    }
                                    options.success(pivotedResult);
                                }
                                catch (e) {
                                    swal.fire('Error', 'Failed to parse data', 'error');
                                    options.success({ data: [] });
                                }
                            }).fail(function (jqXHR) {
                                swal.fire('Error', 'Failed to load data.', 'error');
                                options.success({ data: [] });
                            });
                        }
                    },
                    schema: { model: { id: "LineCode", fields: modelFields } },
                    pageSize: 20
                },
                scrollable: true,
                filterable: {
                    extra: false,
                    operators: {
                        string: {
                            contains: "Contains",
                            eq: "Equal to",
                            neq: "Not equal to"
                        }
                    }
                },
                sortable: true,
                resizable: true,
                reorderable: true,
                pageable: {
                    refresh: true,
                    pageSizes: [20, 50, 100, "all"],
                    buttonCount: 5
                },
                columns: columns,
                toolbar: $("#template_toolbar").html(),
                dataBound: function(e) {
                    o.initAfter();
                }
            });
        },
        eventHandlers: {
            onClickBtnExcel: function () {
                var o = this;
                o.dom.$grid.data('kendoGrid').saveAsExcel();
            },
            onClickBtnUpload: function () {
                var o = this;
                var upload = $("#fileUpload").data('kendoUpload');
                if(upload) upload.clearAllFiles();

                var dpUpload = $("#PeriodeUpload").data("kendoDatePicker");
                if (dpUpload) {
                    dpUpload.value(o.data.UploadDate);
                }
                o.dom.$editorUpload.modal('show');
            },
            onClickBtnDownloadTemplate: function (e) {
                e.preventDefault();
                var dpPeriode = $("#PeriodeUpload").data("kendoDatePicker");
                var selectedDateValue = dpPeriode.value();

                if (!selectedDateValue) {
                    swal.fire('Warning', 'Please select a period first.', 'warning');
                    return;
                }

                var selectedMonth = kendo.toString(selectedDateValue, 'yyyy-MM');
                swal.fire({
                    title: 'Generating Template...',
                    allowOutsideClick: false,
                    didOpen: () => { swal.showLoading() }
                });

                fetch("/ApiProxy/Forward/ParameterRecoverySct/DownloadTemplate?periode=" + selectedMonth, {
                    method: 'GET',
                }).then(async response => {
                    if (!response.ok) {
                        let errorText = await response.text();
                        throw new Error(errorText);
                    }
                    return response.blob();
                }).then(blob => {
                    swal.close();
                    var url = window.URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = "Template_ParameterRecoverySct_" + selectedMonth + ".xlsx";
                    a.click();
                }).catch(error => {
                    swal.close();
                    swal.fire('Download Failed', error.message, 'error');
                });
            },
            onClickBtnSaveUpload: function () {
                var o = this;
                let files = $("#fileUpload").data('kendoUpload').getFiles();
                if (files.length === 0) {
                    swal.fire('Warning', 'Please select a file to upload.', 'warning');
                    return;
                }

                var uploadPeriodStr = kendo.toString($("#PeriodeUpload").data("kendoDatePicker").value(), "yyyy-MM");

                swal.fire({
                    title: 'Upload Parameter Recovery Special CT?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Upload',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        swal.fire({
                            title: 'Uploading...',
                            allowOutsideClick: false,
                            didOpen: () => { swal.showLoading(); }
                        });

                        let formData = new FormData();
                        let file = files[0].rawFile;
                        formData.append('file', file);

                        $.ajax({
                            url: "@myurl" + "ParameterRecoverySct/Upload?UID=" + "@Context.Session.GetString("PIC_ID")" + "&periode=" + uploadPeriodStr,
                            type: 'post',
                            data: formData,
                            contentType: false,
                            processData: false
                        }).done(function (data, textStatus, jqXHR) {
                            o.dom.$editorUpload.modal('hide');
                            swal.fire({
                                title: 'Success!',
                                text: 'Data has been successfully uploaded.',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            });

                            o.generateGrid();
                        }).fail(function (jqXHR, textStatus, errorThrown) {
                            swal.fire({
                                title: 'Upload Failed',
                                html: jqXHR.responseText,
                                icon: 'error',
                                width: '600px'
                            });
                        }).always(function () {
                            $("#fileUpload").data('kendoUpload').clearAllFiles();
                        });
                    }
                });
            }
        },
        init: function () {
            var o = this;
            o.cacheDom();
            o.attachEvents();
            o.generateGrid();
        },
        initAfter: function () {
            var o = this;

            if (!$("#fileUpload").data("kendoUpload")) {
                $("#fileUpload").kendoUpload({
                    multiple: false,
                    validation: {
                        allowedExtensions: [".xls", ".xlsx"],
                        maxFileSize: 5242880
                    },
                    select: function(e) {
                        $.each(e.files, function (index, value) {
                            if (value.extension.toLowerCase() !== ".xls" && value.extension.toLowerCase() !== ".xlsx") {
                                e.preventDefault();
                                swal.fire({ title: 'Invalid File', text: 'Please upload a valid Excel file (.xls or .xlsx)', icon: 'error' });
                            }
                            else if (value.size > 5242880) {
                                e.preventDefault();
                                swal.fire({ title: 'File Too Large', text: 'Excel file size cannot exceed 5MB.', icon: 'error' });
                            }
                        });
                    }
                });
            }

            var today = new Date();

            if (!$("#PeriodeUpload").data("kendoDatePicker")) {
                $("#PeriodeUpload").kendoDatePicker({
                    start: "year",
                    depth: "year",
                    format: "yyyy-MM",
                    value: today
                });
                $("#PeriodeUpload").attr("readonly", true);
            }

            if (!$("#UploadDate").data("kendoDatePicker")) {
                $("#UploadDate").kendoDatePicker({
                    start: "year", 
                    depth: "year", 
                    format: "yyyy-MM",
                    value: o.data.UploadDate,
                    change: function() {
                        o.data.UploadDate = this.value();
                        o.generateGrid();
                    }
                }).attr("readonly", true);
            }
        }
    };

    $(function () {
        AppD.init();
    });
</script>

<script type="text/x-kendo-template" id="template_toolbar">
    <span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Parameter Recovery Special CT -&nbsp;&nbsp;</span>
    <div class="toolbar">
        <button data-toggle="tooltip" title="Save to Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
            <i class="k-icon k-i-excel"></i>
        </button>
        @if (Context.Session.GetString("add_ParameterRecoverySct") == "True")
        {
            <button data-toggle="tooltip" title="Upload Parameter" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
            <i class="k-icon k-i-upload"></i>
        </button>
        }
        &nbsp;&nbsp;
        <input type="date" id="UploadDate" placeholder="Select Period" style="width: 150px;"/>
        &nbsp;&nbsp;
    </div>
</script>