@{
    ViewData["Title"] = "Monthly Plan Result";
    string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<style>
    html, body, .page-main, .page-content {
        height: 100%;
        overflow: hidden;
        margin: 0;
        padding: 0;
    }

    .page-content {
        display: flex;
        flex-direction: column;
    }

    #grid {
        flex: 1;
        width: 100%;
        font-size: 12px !important;
    }
    #grid td {
        font-size: 12px !important;
        white-space: nowrap;
    }

    .row-category {
        font-weight: bold;
        color: #333;
        width: 180px;
        display: inline-block;
        font-size: 12px !important;
    }
    .row-parameter {
        color: #555;
        font-size: 12px !important;
    }

    .k-grid .k-grid-header th {
        font-weight: bold;
        text-align: center;
        background-color: #f5f5f5;
        vertical-align: middle;
        font-size: 12px !important;
    }
    .k-grid .k-grouping-row td {
        background-color: #f0f8ff; 
        color: #0056b3;
        font-weight: bold; 
        font-size: 13px !important; }

    .row-total td {
        background-color: #fff2cc !important;
        font-weight: bold !important;
        color: #cc5200 !important;
    }

    .badge-highest {
        background-color: #fff9e6;
        color: #b35900;
        border: 1px solid #ffe680;
        border-radius: 12px;
        padding: 3px 8px;
        font-weight: bold;
        font-size: 11px;
        display: inline-block;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .badge-highest .star-icon {
        color: #ff9900;
        margin-left: 3px;
        font-size: 12px;
    }

    .editable-cell {
        background-color: #f6fdf6 !important;
        border: 1px dashed #c3e6c3 !important;
        cursor: pointer;
    }
    
    .bg-holiday { 
        background-color: #f2f2f2 !important;
        color: #a6a6a6;
    }
    .bg-understock { 
        background-color: #ffcccc !important;
        color: #cc0000;
        font-weight: bold;
    }
    .bg-overstock { 
        background-color: #ffe5cc !important; 
        color: #cc6600; 
        font-weight: bold;
    }
    .bg-safe {
        background-color: #e2f0d9 !important;
        color: #385723; 
        font-weight: bold;
    }
    .badge-ok {
        background-color: #28a745 !important;
        color: white;
        padding: 4px 10px;
        border-radius: 4px;
        font-weight: bold;
    }
    .badge-ng {
        background-color: #dc3545 !important;
        color: white;
        padding: 4px 10px;
        border-radius: 4px;
        font-weight: bold;
    }
</style>

<div class="page-main">
    <div class="page-content">
        <button type="button" id="btnLoad" class="btn btn-primary" style="display:none;">Load</button>
        <div id="grid"></div>
    </div>
</div>

<script>
    var AppD = {
        attachEvents: function () {
            var o = this;
            o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
            o.dom.$btnLoad.on('click', o.eventHandlers.onClickBtnLoad.bind(o));
            o.dom.$grid.on('click', '#btnSubmitEdit', o.eventHandlers.onClickBtnSubmitEdit.bind(o));
        },
        cacheDom: function () {
            var o = this;
            o.dom.$grid = $("#grid");
            o.dom.$btnLoad = $("#btnLoad");
        },
        currentRevisionNo: -1,
        data: {
            Periode: new Date()
        },
        dom: {},
        eventHandlers: {
            onClickBtnExcel: function () {
                var o = this;
                o.dom.$grid.data('kendoGrid').saveAsExcel();
            },
            onClickBtnLoad: function(){
                var o = this;

                swal.fire({
                    title: 'Loading Data...',
                    allowOutsideClick: false,
                    didOpen: () => { swal.showLoading(); }
                });

                var reqPeriode = kendo.toString(o.data.Periode, 'yyyyMM');

                $.ajax({
                    method: 'post',
                    headers: { 'Content-Type': 'application/json' },
                    url: "@myurl" + 'MonthlyPlanResults/GetRevisions',
                    dataType: 'json',
                    data: JSON.stringify({ Periode: reqPeriode })
                }).done(function (revisionList) {

                    if (o.currentRevisionNo === -1) {
                        if (revisionList && revisionList.length > 0) {
                            o.currentRevisionNo = Math.max.apply(Math, revisionList);
                        } else {
                            o.currentRevisionNo = 0;
                        }
                    }


                    $.ajax({
                        method: 'post',
                        headers: { 'Content-Type': 'application/json' },
                        url: "@myurl" + 'MonthlyPlanResults/GetResultList',
                        dataType: 'json',
                        data: JSON.stringify({
                            Periode: reqPeriode,
                            RevisionNo: o.currentRevisionNo
                        })
                    }).done(function (rawData) {
                        swal.close();

                        if (rawData.length === 0) {
                            swal.fire('Info', 'No data found for this period.', 'info');
                        }

                        o.buildPivotedGrid(rawData, revisionList);

                    }).fail(function (jqXHR) {
                        swal.fire('Error', 'Failed to load data from server', 'error');
                    }).always(function (){
                        swal.close();
                    });
                }).fail(function (jqXHR) {
                    swal.fire('Error Fetching Revisions', '', 'error');
                });
            },
            onClickBtnSubmitEdit: function() {
                var o = this;
                var grid = o.dom.$grid.data('kendoGrid');

                grid.closeCell();

                var updatedRows = grid.dataSource.updated();

                if (updatedRows.length === 0) {
                    swal.fire('Info', 'No changes detected. Edit some cells first.', 'info');
                    return;
                }

                var payload = [];
                var yearMonth = kendo.toString(o.data.Periode, "yyyy-MM");

                updatedRows.forEach(row => {
                    if (row.Category === "DETAIL OUTPUT (UNIQUE)") {
                        for (let key in row) {
                            if (key.startsWith("D") && key !== "dirty" && key.indexOf("_") === -1) {
                                var dayNum = key.replace("D", "");
                                var dateStr = yearMonth + "-" + dayNum.padStart(2, '0');
                                payload.push({
                                    Periode: yearMonth.replace('-', ''),
                                    RevisionNo: o.currentRevisionNo,
                                    LineCode: row.LineCode,
                                    UniqueCode: row.UniqueCode,
                                    TargetDate: dateStr,
                                    FinalPlanQty: parseInt(row[key]) || 0
                                });
                            }
                        }
                    }
                });

                if(payload.length === 0) return;

                swal.fire({ title: 'Saving Data...', allowOutsideClick: false, didOpen: () => { swal.showLoading(); } });

                $.ajax({
                    method: 'post',
                    url: "@myurl" + 'MonthlyPlanResults/UpdateDetailOutput',
                    headers: { 'Content-Type': 'application/json' },
                    data: JSON.stringify(payload)
                }).done(function(res) {
                    swal.fire('Success', 'Manual adjust saved! Re-calculating Stock...', 'success').then(() => {
                        o.dom.$btnLoad.click();
                    });
                }).fail(function() {
                    swal.fire('Error', 'Failed to save data', 'error');
                });
            }
        },

        buildPivotedGrid: function(rawData, revisionList) {
            var o = this;

            if (typeof o.dom.$grid.data('kendoGrid') != 'undefined') {
                o.dom.$grid.data('kendoGrid').destroy();
                o.dom.$grid.empty();
            }

            var monthName = kendo.toString(o.data.Periode, "MMM");
            var days = [];
            rawData.forEach(r => {
                var dNum = parseInt(r.TargetDate.split('T')[0].split('-')[2], 10);
                if (!days.includes(dNum)) days.push(dNum);
            });
            days.sort((a, b) => a - b);

            var lines = [...new Set(rawData.map(x => x.LineCode))];
            var pivotedData = [];

            var rowIdCounter = 1;

            var getCatOrder = function(catName) {
                var order = {
                    "ORDER DAILY CUSTOMER": 1,
                    "OUTPUT PRODUKSI": 2,
                    "DETAIL OUTPUT (UNIQUE)": 3,
                    "PRODUCTION OPERATION": 4,
                    "OVERTIME": 5,
                    "MANDATORY / PDT": 6,
                    "SPEED PARAMETERS": 7,
                    "STOCK FLOW END SHIFT": 8,
                    "JUDGEMENT": 9
                };
                return order[catName] || 99;
            };
            
            // =========================================================
            // PIVOTING ENGINE 
            // =========================================================
            lines.forEach(function(line) {
                var lineData = rawData.filter(x => x.LineCode === line);
                var uniques = [...new Set(lineData.map(x => x.UniqueCode))];
                var seqNum = 1;

                var calcRowTotal = function(r) {
                    var sum = 0;
                    days.forEach(d => sum += (r["D" + d] || 0));
                    return sum;
                };

                var getVal = function(dNum, unique, field) {
                    var dateStr = '-' + dNum.toString().padStart(2, '0') + 'T';
                    var row = lineData.find(x => x.UniqueCode === unique && x.TargetDate.indexOf(dateStr) !== -1);
                    return row ? row[field] : 0;
                };

                var getLineVal = function(dNum, field) {
                    var dateStr = '-' + dNum.toString().padStart(2, '0') + 'T';
                    var row = lineData.find(x => x.TargetDate.indexOf(dateStr) !== -1);
                    return row ? row[field] : 0;
                };

                var addRow = function(cat, param, unq, min, max, begin) {
                    var r = {
                        RowId: rowIdCounter++,
                        LineCode: line, 
                        SeqNum: seqNum++, 
                        Category: cat,
                        CategoryGroup: getCatOrder(cat).toString().padStart(2, '0') + "|" + cat,
                        Parameter: param,
                        UniqueCode: unq || "-",
                        MinStock: min !== undefined ? min : null, 
                        MaxStock: max !== undefined ? max : null, 
                        BeginStock: begin !== undefined ? begin : null
                    };
                    
                    days.forEach(d => {
                        var opTime = getLineVal(d, "OperatingTime");
                        r["D" + d] = 0;
                        r["Off_D" + d] = (opTime === 0);
                    });
                    return r;
                };

                // 1. ORDER DAILY CUSTOMER
                uniques.forEach(u => {
                    var sampleModel = lineData.find(x => x.UniqueCode === u);
                    var r = addRow("ORDER DAILY CUSTOMER", u, u);
                    r.IsHighestOrder = sampleModel ? sampleModel.IsHighestOrder : false;
                    days.forEach(d => r["D" + d] = getVal(d, u, "OrderQty"));
                    r.RowTotal = calcRowTotal(r);
                    pivotedData.push(r);
                });

                // 2. OUTPUT PRODUKSI
                var rOutTot = addRow("OUTPUT PRODUKSI", "Total", "-");
                var rOutDay = addRow("OUTPUT PRODUKSI", "Day Shift", "-");
                var rOutNight = addRow("OUTPUT PRODUKSI", "Night Shift", "-");
                days.forEach(d => {
                    var dayVal = getLineVal(d, "OutputProduksiDay");
                    var nightVal = getLineVal(d, "OutputProduksiNight");
                    rOutDay["D" + d] = dayVal; rOutNight["D" + d] = nightVal; rOutTot["D" + d] = dayVal + nightVal;
                });
                pivotedData.push(rOutTot, rOutDay, rOutNight);

                // 3. DETAIL OUTPUT (UNIQUE)
                uniques.forEach(u => {
                    var sampleModel = lineData.find(x => x.UniqueCode === u);
                    var r = addRow("DETAIL OUTPUT (UNIQUE)", u, u);
                    r.IsHighestOrder = sampleModel ? sampleModel.IsHighestOrder : false;
                    days.forEach(d => r["D" + d] = getVal(d, u, "FinalPlanQty"));
                    r.RowTotal = calcRowTotal(r);
                    pivotedData.push(r);
                });

                // 4. PRODUCTION OPERATION
                var rOpTime = addRow("PRODUCTION OPERATION", "Operating Time", "-");
                var rNwTime = addRow("PRODUCTION OPERATION", "Normal Working Time", "-");
                var rNwDay = addRow("PRODUCTION OPERATION", "Day Shift", "-");
                var rNwNight = addRow("PRODUCTION OPERATION", "Night Shift", "-");
                days.forEach(d => {
                    rOpTime["D" + d] = getLineVal(d, "OperatingTime"); 
                    rNwTime["D" + d] = getLineVal(d, "NormalWorkingTotal");
                    rNwDay["D" + d] = getLineVal(d, "NormalWorkingDay");
                    rNwNight["D" + d] = getLineVal(d, "NormalWorkingNight");
                });
                pivotedData.push(rOpTime, rNwTime, rNwDay, rNwNight);

                // 5. OVERTIME
                var rOtDay = addRow("OVERTIME", "Ori: Day", "-"); 
                var rOtNight = addRow("OVERTIME", "Ori: Night", "-"); 
                var rOtTot = addRow("OVERTIME", "TOTAL ORI", "-");
                var rRcDay = addRow("OVERTIME", "Recovery: Day", "-"); 
                var rRcNight = addRow("OVERTIME", "Recovery: Night", "-"); 
                var rRcTot = addRow("OVERTIME", "TOTAL RECOVERY", "-");
                days.forEach(d => {
                    rOtDay["D" + d] = getLineVal(d, "OvertimeDay"); 
                    rOtNight["D" + d] = getLineVal(d, "OvertimeNight"); 
                    rOtTot["D" + d] = getLineVal(d, "OvertimeTotal");
                    rRcDay["D" + d] = getLineVal(d, "RecoveryDay"); 
                    rRcNight["D" + d] = getLineVal(d, "RecoveryNight"); 
                    rRcTot["D" + d] = getLineVal(d, "RecoveryTotal");
                });
                pivotedData.push(rOtDay, rOtNight, rOtTot, rRcDay, rRcNight, rRcTot);

                // 6. MANDATORY / PDT
                var rMdDay = addRow("MANDATORY / PDT", "Mandatory: Day", "-"); 
                var rMdNight = addRow("MANDATORY / PDT", "Mandatory: Night", "-");
                var rPdDay = addRow("MANDATORY / PDT", "PDT Other: Day", "-"); 
                var rPdNight = addRow("MANDATORY / PDT", "PDT Other: Night", "-");
                var rAmDay = addRow("MANDATORY / PDT", "AM/PM: Day", "-"); 
                var rAmNight = addRow("MANDATORY / PDT", "AM/PM: Night", "-"); var rPdTot = addRow("MANDATORY / PDT", "TOTAL PDT", "-");
                days.forEach(d => {
                    rMdDay["D" + d] = getLineVal(d, "MandatoryDay"); 
                    rMdNight["D" + d] = getLineVal(d, "MandatoryNight");
                    rPdDay["D" + d] = getLineVal(d, "PdtOtherDay");
                    rPdNight["D" + d] = getLineVal(d, "PdtOtherNight");
                    rAmDay["D" + d] = getLineVal(d, "AmPmDay"); 
                    rAmNight["D" + d] = getLineVal(d, "AmPmNight");
                    rPdTot["D" + d] = rPdDay["D" + d] + rPdNight["D" + d] + rAmDay["D" + d] + rAmNight["D" + d];
                });
                pivotedData.push(rMdDay, rMdNight, rPdDay, rPdNight, rAmDay, rAmNight, rPdTot);

                // 7. SPEED PARAMETERS
                var rCt = addRow("SPEED PARAMETERS", "Cycle Time", "-"); 
                var rSct = addRow("SPEED PARAMETERS", "Special Cycle Time", "-"); 
                var rOee = addRow("SPEED PARAMETERS", "OEE (%)", "-");
                days.forEach(d => {
                    rCt["D" + d] = getLineVal(d, "CycleTime"); 
                    rSct["D" + d] = getLineVal(d, "SpecialCycleTime"); 
                    rOee["D" + d] = getLineVal(d, "OEE");
                });
                pivotedData.push(rCt, rSct, rOee);

                // 8. STOCK FLOW END SHIFT
                uniques.forEach(u => {
                    var target = lineData.find(x => x.UniqueCode === u);
                    var min = target ? target.MinStock : 0;
                    var max = target ? target.MaxStock : 0;
                    var begin = target ? target.BeginStock : 0;

                    var r = addRow("STOCK FLOW END SHIFT", u, u, min, max, begin);
                    r.IsHighestOrder = target ? target.IsHighestOrder : false;

                    days.forEach(d => r["D" + d] = getVal(d, u, "EndStock"));
                    r.RowTotal = null;
                    pivotedData.push(r);
                });

                var totalMin = 0, totalMax = 0, totalBegin = 0;
                uniques.forEach(u => {
                    var target = lineData.find(x => x.UniqueCode === u);
                    totalMin += target && target.MinStock ? target.MinStock : 0;
                    totalMax += target && target.MaxStock ? target.MaxStock : 0;
                    totalBegin += target && target.BeginStock ? target.BeginStock : 0;
                });

                var rStkTot = addRow("STOCK FLOW END SHIFT", "TOTAL STOCK", "-", totalMin, totalMax, totalBegin);

                days.forEach(d => {
                    var sum = 0;
                    uniques.forEach(u => sum += getVal(d, u, "EndStock"));
                    rStkTot["D" + d] = sum;
                });
                pivotedData.push(rStkTot);

                // 9. JUDGEMENT (POKAYOKE)
                var rJudgement = addRow("JUDGEMENT", "Pokayoke", "-");
                days.forEach(d => {
                    var isNG = false;
                    uniques.forEach(u => {
                        var sampleModel = lineData.find(x => x.UniqueCode === u);
                        var minStock = sampleModel ? sampleModel.MinStock : 0;
                        var endStock = getVal(d, u, "EndStock");

                        if (endStock < minStock) {
                            isNG = true;
                        }
                    });
                    rJudgement["D" + d] = isNG ? 1 : 0;
                });
                //rJudgement.RowTotal = null;
                rJudgement.RowTotal = calcRowTotal(rJudgement);
                pivotedData.push(rJudgement);
            });
            
            var schemaFields = {
                RowId: { type: "number", editable: false },
                LineCode: { type: "string", editable: false },
                Category: { type: "string", editable: false },
                CategoryGroup: { type: "string", editable: false },
                Parameter: { type: "string", editable: false },
                SeqNum: { type: "number", editable: false },
                UniqueCode: { type: "string", editable: false },
                MinStock: { type: "number", editable: false },
                MaxStock: { type: "number", editable: false },
                BeginStock: { type: "number", editable: false },
                RowTotal: { type: "number", editable: false },
                IsHighestOrder: { type: "boolean", editable: false }
            };

            var columns = [
                { 
                    field: "LineCode", 
                    title: "Line", 
                    hidden: true, 
                    groupHeaderTemplate: "Line Production: #= value #" 
                }, {
                    field: "CategoryGroup",
                    hidden: true,
                    groupHeaderTemplate: function(e) {
                        var catName = e.value.split('|')[1];
                        return "<span class='cat-group' data-cat='" + catName + "'>" + catName + "</span>";
                    }
                }, { 
                    field: "SeqNum", 
                    hidden: true 
                }, {
                    field: "Parameter",
                    title: "Parameter", 
                    width: 320, 
                    locked: true,
                    filterable: { 
                        cell: { 
                            operator: "contains", 
                            suggestionOperator: "contains" 
                        }
                    },
                    template: function(dataItem) {
                        var num = "<span style='display:inline-block; width:25px; font-weight:bold; color:\\#333;'>" + dataItem.SeqNum + ".</span>";
                        return num + "<span class='row-category'>" + dataItem.Category + "</span> <span class='row-parameter'>" + dataItem.Parameter + "</span>";
                    }
                }, { 
                    field: "UniqueCode",
                    title: "Unique", 
                    width: 80, 
                    locked: true, 
                    attributes: { 
                        style: "text-align:center; font-weight:bold;" 
                    } 
                }, {
                    field: "RowTotal", 
                    title: "Total",
                    width: 85, 
                    locked: true,
                    attributes: { 
                        style: "text-align:right; font-weight:bold;"
                    },
                    template: function(dataItem) {
                        if ((dataItem.UniqueCode === "-" && dataItem.Category !== "JUDGEMENT") || dataItem.RowTotal === null || dataItem.RowTotal === undefined)
                            return "";

                        if (dataItem.Category === "JUDGEMENT") {
                            if (dataItem.RowTotal > 0) {
                                return "<span style='color: #dc3545; font-size: 11px;'>" + dataItem.RowTotal + " Hari NG</span>";
                            }
                            return "<span style='color: #28a745; font-size: 11px;'>All OK</span>";
                        }
                        
                        if (dataItem.IsHighestOrder === true) {
                            return "<span class='badge-highest'>" + dataItem.RowTotal + " <span class='star-icon'>★</span></span>";
                        }
                        
                        return dataItem.RowTotal;
                    }
                }, { 
                    field: "MinStock", 
                    title: "Min",
                    width: 60, 
                    locked: true, 
                    attributes: { 
                        style: "text-align:right;" 
                    }, 
                    template: "#= MinStock !== null ? MinStock : '' #"
                }, { 
                    field: "MaxStock", 
                    title: "Max", 
                    width: 60, 
                    locked: true,
                    attributes: { 
                        style: "text-align:right;" 
                    }, 
                    template: "#= MaxStock !== null ? MaxStock : '' #" 
                }, { 
                    field: "BeginStock",
                    title: "Begin", 
                    width: 65,
                    locked: true, 
                    attributes: { 
                        style: "text-align:right; font-weight:bold;"
                    }, 
                    template: "#= BeginStock !== null ? BeginStock : '' #"
                }
            ];

            days.forEach(d => {
                schemaFields["D" + d] = { 
                    type: "number", 
                    validation: { 
                        min: 0
                    } 
                };
                
                columns.push({
                    field: "D" + d,
                    title: d + "-" + monthName,
                    width: 65,
                    attributes: { style: "text-align:right;" },
                    headerAttributes: { style: "text-align: center;" },
                    template: function(dataItem) {
                        var val = dataItem["D" + d];
                        
                        if (val === 0 && dataItem.Category !== "STOCK FLOW END SHIFT" && dataItem.Category !== "ORDER DAILY CUSTOMER")
                            val = "0";

                        var customClass = "";

                        if(dataItem.Category === "DETAIL OUTPUT (UNIQUE)" && dataItem.IsHighestOrder !== true)
                            customClass += " editable-cell ";
                        
                        if(dataItem["Off_D" + d] && dataItem.Category !== "STOCK FLOW END SHIFT")
                            customClass += " bg-holiday ";

                        if (dataItem.Category === "JUDGEMENT") {
                            if (val === 1) 
                                return "<div style='text-align:center;'><span class='badge-ng'>NG</span></div>";
                            
                            return "<div style='text-align:center;'><span class='badge-ok'>OK</span></div>";
                        }
                        
                        if(dataItem.Category === "STOCK FLOW END SHIFT" && dataItem.Parameter !== "TOTAL STOCK") {
                            if(val < dataItem.MinStock) 
                                customClass += " bg-understock ";
                            else if(val > dataItem.MaxStock) 
                                customClass += " bg-overstock ";
                            else 
                                customClass += " bg-safe ";
                        }

                        return customClass.trim() !== "" ? "<div class='" + customClass + "' style='padding:4px; margin:-4px -8px;'>" + val + "</div>" : val;
                    }
                });
            });

            
            o.dom.$grid.kendoGrid({
                excel: { 
                    fileName: "Monthly_Capacity_Result.xlsx",
                    allPages: true, 
                    filterable: true
                },
                dataSource: {
                    data: pivotedData,
                    schema: { 
                        model: {
                            id: "RowId",
                            fields: schemaFields 
                        } 
                    },
                    group: [
                        { field: "LineCode" },
                        { field: "CategoryGroup" }
                    ],
                },
                editable: true,
                navigatable: true,
                scrollable: true,
                sortable: false,
                resizable: true,
                filterable: { 
                    extra: false,
                    operators: {
                        string: { 
                            contains: "Contains", 
                            eq: "Equal to"
                        }
                    } 
                },
                columns: columns,
                toolbar: $("#template_toolbar").html(),
                edit: function(e) {
                    if (e.model.Category !== "DETAIL OUTPUT (UNIQUE)" || e.model.IsHighestOrder === true) {
                        this.closeCell();
                    }
                },
                dataBound: function (e) {
                    o.initAfter();
                    var grid = e.sender;
                    var applyRowStyles = function(rows) {
                        rows.each(function () {
                            var dataItem = grid.dataItem(this);
                            if (!dataItem) 
                                return;
                            
                            if (dataItem.Parameter === "Day Shift") 
                                $(this).css("border-top", "2px solid #ccc");

                            if (dataItem.Parameter && dataItem.Parameter.toUpperCase().indexOf("TOTAL") !== -1)
                                $(this).addClass("row-total");
                        });
                    };

                    applyRowStyles(grid.tbody.find("tr:not(.k-grouping-row)"));
                    if(grid.lockedTable) {
                        applyRowStyles(grid.lockedTable.find("tr:not(.k-grouping-row)"));
                    }

                    var targetTable = grid.lockedTable ? grid.lockedTable : grid.tbody;

                    targetTable.find(".k-grouping-row").each(function () {
                        var row = $(this);
                        var catSpan = row.find(".cat-group");

                        if (catSpan.length > 0) {
                            var catName = catSpan.attr("data-cat");

                            if (catName !== "DETAIL OUTPUT (UNIQUE)") {
                                grid.collapseGroup(row);
                            }
                        }
                    });

                    var titleText = "Monthly Plan Result";
                    if (o.currentRevisionNo > 0) {
                        titleText += " <span class='badge-revision'>REVISION " + o.currentRevisionNo + "</span>";
                    } else {
                        titleText += " <span class='badge-original'>Original</span>";
                    }
                    o.dom.$grid.find(".grid-title-centered").html(titleText);

                    var dropdownRevisionData = [];
                    if (revisionList && revisionList.length > 0) {
                        revisionList.forEach(function (rev) {
                            dropdownRevisionData.push({
                                Text: rev === 0 ? "Original" : "Revision " + rev,
                                Value: rev
                            });
                        });
                    }

                    $("#FilterRevision").kendoDropDownList({
                        dataTextField: "Text",
                        dataValueField: "Value",
                        dataSource: dropdownRevisionData,
                        value: o.currentRevisionNo,
                        change: function () {
                            o.currentRevisionNo = parseInt(this.value());
                            o.dom.$btnLoad.click();
                        }
                    });

                    if (dropdownRevisionData.length <= 1) {
                        $("#ContainerRevision").hide();
                    } else {
                        $("#ContainerRevision").show();
                    }
                }
            });
        },

        init: function () {
            var o = this;
            o.cacheDom();
            o.attachEvents();
            o.initElements();
        },
        initElements: function () {
            var o = this;
            o.dom.$btnLoad.click();
        },
        initAfter: function () {
            var o = this;
            if (!$("#Periode").data("kendoDatePicker")) {
                $("#Periode").kendoDatePicker({
                    start: "year", 
                    depth: "year",
                    format: 'yyyy-MM', 
                    value: o.data.Periode,
                    change: function () { 
                        o.data.Periode = this.value(); 
                        if (this.value()) {
                            o.currentRevisionNo = -1;
                            o.dom.$btnLoad.click();
                        }
                    }
                });
                $("#Periode").attr("readonly", true);
            }
        }
    };

    $(function () {
        AppD.init();
    });
</script>

<script type="text/x-kendo-template" id="template_toolbar">
    <span class="k-pager-refresh" style="font-weight: bold;">&nbsp;&nbsp; - Monthly Plan Results - &nbsp;&nbsp;</span>
    <div class="toolbar" style="float: right;">
        <button data-toggle="tooltip" title="Save to Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
          <i class="k-icon k-i-excel"></i>
        </button>
        
        @if (Context.Session.GetString("edit_MonthlyPlanResults") == "True")
        {
            <button data-toggle="tooltip" title="Edit" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnSubmitEdit">
                <i class="k-icon k-i-save"></i>
            </button>
        }

        &nbsp;&nbsp;        
        <input type="text" id="Periode" placeholder="Select Period" style="width: 150px; margin-right: 15px;" />

        <div id="ContainerRevision" style="display: inline-block;">
            <label>Data Version: </label>
            <input type="text" id="FilterRevision" style="width: 130px;" />
        </div>
    </div>
</script>