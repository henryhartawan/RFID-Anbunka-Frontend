@{
    ViewData["Title"] = "Monthly Summary Order";
    string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}
<style>
   .page-content {
      display: block;
   }
   #grid {
      width: 100%;
      min-height: 350px;
   }
</style>

<div class="page-main">
    <div class="page-content padding-10">
       <button type="button" id="btnLoad" class="btn btn-primary" style="display:none;">Load</button>
       
       <div id="grid"></div>
    </div>
</div>

<script>
    var AppD = {
       attachEvents: function () {
          var o = this;
          o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
          o.dom.$btnLoad.on('click', o.eventHandlers.onClickBtnLoad.bind(o));
       },
       cacheDom: function () {
          var o = this;
          o.dom.$grid = $("#grid");
          o.dom.$btnLoad = $("#btnLoad");
       },
       data: {
          UploadDate: new Date(),
       },
       currentRevisionNo: -1,
       dom: {},
       eventHandlers: {
          onClickBtnExcel: function () {
             var o = this;
             o.dom.$grid.data('kendoGrid').saveAsExcel();
          },
          onClickBtnLoad: function(){
             var o = this;

             kendo.ui.progress(o.dom.$grid, true);
             var reqUploadDate = kendo.toString(o.data.UploadDate, 'yyyyMM');

             $.ajax({
                method: 'post',
                headers: { 'Content-Type': 'application/json' },
                url: "@myurl" + 'MonthlySummaryOrder/GetRevisions',
                dataType: 'json',
                data: JSON.stringify({ UploadDate: reqUploadDate })
             }).done(function(revisionList) {
                
                if (o.currentRevisionNo === -1) {
                   if (revisionList && revisionList.length > 0) {
                      o.currentRevisionNo = Math.max.apply(Math, revisionList);
                   } else {
                      o.currentRevisionNo = 0;
                   }
                }

                $.ajax({
                   method: 'post',
                   headers: { 'Content-Type': 'application/json' },
                   url: "@myurl" + 'MonthlySummaryOrder/INQ',
                   dataType: 'json',
                   data: JSON.stringify({
                      UploadDate: reqUploadDate,
                      RevisionNo: o.currentRevisionNo
                   })
                }).done(function (data) {
                   var isEmpty = (!data || data.length === 0);

                   if (isEmpty) {
                      swal.fire('Info', 'No data available for the selected period.', 'info');
                      data = [];
                   }

                   if (typeof o.dom.$grid.data('kendoGrid') != 'undefined') {
                      o.dom.$grid.data('kendoGrid').destroy();
                      o.dom.$grid.empty();
                   }

                   var result = [];
                   if(!isEmpty){
                      data.forEach(function(row) {
                         var newRow = {};
                         for(var k in row) {
                            if(row.hasOwnProperty(k)) {
                               var safeKey = k.replace(/\+/g, '_plus_').replace(/\-/g, '_min_').replace(/\s/g, '_');
                               newRow[safeKey] = row[k];
                            }
                         }
                         result.push(newRow);
                      });
                   }

                   var schemaFields = {
                      GroupOrder: {type: "number"},
                      OrderFrom: {type: "string"},
                      EngineBase: {type: "string"},
                      UniqueCode: {type: "string"},
                      EngineType: {type: "string"},
                      Suffix: {type: "string"},
                      Total: {type: "number"}
                   };

                   var columns = [
                      {
                         field: "GroupOrder",
                         hidden: true,
                         groupHeaderTemplate: function(e) {
                            var orderFrom = e.items && e.items.length > 0 ? e.items[0].OrderFrom : '';
                            if(orderFrom === 'RESUME ENGINE') {
                               return "<span style='color: rgb(56, 118, 29); font-weight: bold; font-size: 14px;'>Resume Engine</span>";
                            }
                            return orderFrom;
                         }
                      },
                      { field: "OrderFrom", hidden: true },
                      { field: "EngineBase", title: "EG Base", width: 100 },
                      { field: "UniqueCode", title: "UN", width: 80 },
                      { field: "EngineType", title: "Type", width: 100 },
                      { field: "Suffix", title: "Suffix / Part Number", width: 160 },
                      {
                         field: "Total",
                         title: "REV-0",
                         width: 100,
                         attributes: { style: "text-align: right; font-weight: bold;" },
                         headerAttributes: { style: "text-align: right; font-weight: bold;" },
                         aggregates: ["sum"],
                         groupFooterTemplate: "<div style='text-align:right'>#=sum#</div>",
                         footerTemplate: "<div style='text-align:right'><strong>#= sum / 2 #</strong></div>"
                      }
                   ];
   
                   var aggregateConfig = [
                      { field: "Total", aggregate: "sum" }
                   ];

                   var pYear = parseInt(reqUploadDate.substring(0, 4));
                   var pMonth = parseInt(reqUploadDate.substring(4, 6));
   
                   if(!isEmpty) {
                      $.ajax({
                         method: 'post',
                         headers: { 'Content-Type': 'application/json' },
                         url: "@myurl" + 'MonthlySummaryOrder/CheckMismatch',
                         dataType: 'json',
                         data: JSON.stringify({
                            UploadDate: reqUploadDate,
                            RevisionNo: o.currentRevisionNo
                         })
                      }).done(function (valData) {
                         var hasMismatch = valData.isMismatch || valData.IsMismatch;
                         var msg = valData.message || valData.Message;

                         if (hasMismatch) {
                            swal.fire({
                               icon: 'warning',
                               title: 'Warning: Mismatch Found!',
                               html: msg,
                               confirmButtonColor: '#d33'
                            });
                         }
                      }).fail(function () {
                         console.warn("Failed to load mismatch checking data.");
                      });
                      
                      for(var key in data[0]){
                         if(data[0].hasOwnProperty(key)){
                            if(key.indexOf("Day_") === 0){
                               var dayNum = parseInt(key.replace("Day_", ""));
   
                               var d = new Date(pYear, pMonth - 1, dayNum);
                               var finalTitle = kendo.toString(d, "dd-MMM");
   
                               schemaFields[key] = {type: 'number'};
                               aggregateConfig.push({ field: key, aggregate: "sum" });
   
                               columns.push({
                                  field: key,
                                  title: finalTitle,
                                  width: 80,
                                  attributes: { style: "text-align: right;" },
                                  headerAttributes: { style: "text-align: right;" },
                                  aggregates: ["sum"],
                                  groupFooterTemplate: "<div style='text-align:right'>#=sum#</div>",
                                  footerTemplate: "<div style='text-align:right'><strong>#= sum / 2 #</strong></div>"
                               });
                            }
                         }
                      }
                   }

                   o.dom.$grid.kendoGrid({
                      excel: {
                         fileName: "Monthly Summary Order.xlsx",
                         allPages: true,
                         filterable: true
                      },
   
                      excelExport: function(e) {
                         var sheet = e.workbook.sheets[0];
   
                         for (var i = 0; i < sheet.rows.length; i++) {
                            var row = sheet.rows[i];
   
                            for (var j = 0; j < row.cells.length; j++) {
                               var cell = row.cells[j];
   
                               if (cell.value && typeof cell.value === "string") {
                                  cell.value = cell.value.replace(/<br\s*[\/]?>/gi, "\n");
                                  cell.value = cell.value.replace(/<\/?[^>]+(>|$)/g, "");
                                  cell.value = cell.value.trim();
   
                                  if (!isNaN(cell.value) && cell.value !== "") {
                                     cell.value = Number(cell.value);
                                  }
                                  else if (typeof cell.value === "string" && cell.value.indexOf("\n") >= 0) {
                                     cell.wrap = true;
                                  }
                               }
                            }
                         }
                      },
   
                      dataSource: {
                         data: result,
                         schema: {
                            model: { fields: schemaFields }
                         },
                         group: {
                            field: "GroupOrder",
                            aggregates: aggregateConfig
                         },
                         aggregate: aggregateConfig
                      },
                      scrollable: true,
                      sortable: true,
                      resizable: true,
                      reorderable: true,
                      filterable: {
                         extra: false,
                         operators: {
                            string: {
                               contains: "Contains",
                               eq: "Equal to",
                               neq: "Not equal to"
                            }
                         }
                      },
                      pageable: {
                         refresh: true,
                         input: true,
                         numeric: true,
                         pageSizes: true,
                         buttonCount: 5
                      },
                      columns: columns,
                      toolbar: $("#template_toolbar").html(),
                      dataBound: function(e) {
                         o.initAfter();
   
                         var grid = e.sender;
                         grid.tbody.find("tr.k-grouping-row").each(function () {
                            var rowText = $(this).text().toUpperCase();
   
                            if (rowText.indexOf("RESUME ENGINE") > -1) {
                               $(this).css("background-color", "rgb(226, 240, 217)");
                               $(this).nextUntil(".k-grouping-row").css("background-color", "rgb(226, 240, 217)");
                               grid.expandGroup(this);
                            } else {
                               grid.collapseGroup(this);
                            }
                         });
                      }
                   });
   
                   var titleText = "- Monthly Summary Order -";
                   if (o.currentRevisionNo > 0) {
                      titleText += " <span class='badge-revision'>REVISION " + o.currentRevisionNo + "</span>";
                   } else {
                      titleText += " <span class='badge-original'>Original</span>";
                   }
                   o.dom.$grid.find(".grid-title-centered").html(titleText);
   
                   var dropdownRevisionData = [];
                   if (revisionList && revisionList.length > 0) {
                      revisionList.forEach(function (rev) {
                         dropdownRevisionData.push({
                            Text: rev === 0 ? "Original" : "Revision " + rev,
                            Value: rev
                         });
                      });
                   }
   
                   $("#FilterRevision").kendoDropDownList({
                      dataTextField: "Text",
                      dataValueField: "Value",
                      dataSource: dropdownRevisionData,
                      value: o.currentRevisionNo,
                      change: function () {
                         o.currentRevisionNo = parseInt(this.value());
                         o.dom.$btnLoad.click();
                      }
                   });
   
                   if (dropdownRevisionData.length <= 1) {
                      $("#ContainerRevision").hide();
                   } else {
                      $("#ContainerRevision").show();
                   }
   
                }).fail(function (jqXHR) {
                   swal.fire('Error', 'Failed to load summary data.', 'error');
                }).always(function () {
                   kendo.ui.progress(o.dom.$grid, false);
                });

             }).fail(function (jqXHR) {
                swal.fire('Error', 'Failed to load summary data.', 'error');
             }).always(function () {
                kendo.ui.progress(o.dom.$grid, false);
             });
          }
       },
       init: function () {
          var o = this;
          o.cacheDom();
          o.attachEvents();
          o.initElements();
       },
       initElements: function () {
          var o = this;
          o.dom.$btnLoad.click();
       },
       initAfter: function () {
          var o = this;
          o.dom.UploadDate = $("#UploadDate");

          if(!o.dom.UploadDate.data("kendoDatePicker")) {
             o.dom.UploadDate.kendoDatePicker({
                start: "year",
                depth: "year",
                format: 'yyyyMM',
                value: o.data.UploadDate,
                change: function () {
                   o.data.UploadDate = this.value() != null ? this.value() : '';

                   if(this.value()){
                      o.currentRevisionNo = -1;
                      o.dom.$btnLoad.click();
                   }
                }
             });
             
             o.dom.UploadDate.attr("readonly", true);
          }
       }
    };

    $(function () {
       AppD.init();
    });
</script>

<script type="text/x-kendo-template" id="template_toolbar">
    <span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Monthly Summary Order -&nbsp;&nbsp;</span>
    <div class="toolbar">
        <button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
            <i class="k-icon k-i-excel"></i>
        </button>
        &nbsp;&nbsp;
        <input type="date" id="UploadDate" placeholder="Periode" />
    </div>
    
    <div id="ContainerRevision" style="display: inline-block; margin-left: 15px;">
       <label>Data Version: </label>
       <input type="text" id="FilterRevision" style="width: 130px;" />
    </div>
</script>