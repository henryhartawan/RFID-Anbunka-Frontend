@{
	ViewData["Title"] = "Customer Order";
	string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<style>
    .k-grid td {
       font-size: 11px !important;
    }
</style>

<div class="page-main">
	<div class="page-content padding-5">
		<div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
	</div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="padding-top:25vh;">
	<div class="" role="document" style="padding-left:25vw;">
		<div class="modal-content" style="width:50vw">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<h4 class="modal-title" id="myModalTitle">Upload Customer Order</h4>
			</div>
			<div class="modal-body margin-bottom-0 padding-bottom-0">
				<form id="formUpload" enctype="multipart/form-data" class="form-horizontal">

					<div class="form-group">
						<label class="col-sm-2 control-label" style="text-align:left;">File Excel</label>
						<div class="col-sm-10">
							<input type="file" name="file" id="fileUpload" accept=".xls,.xlsx" />
						</div>
					</div>

				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default" data-dismiss="modal" id='clear'>Close</button>
				<button type="button" class="btn btn-primary" id="btnSaveUpload">Upload</button>
			</div>
		</div>
	</div>
</div>

<script>
	var IUType = 'I';

	var AppD = {
		attachEvents: function () {
			var o = this;
			o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));

			o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
			o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
			o.dom.$grid.on('click', '#btnDelete', o.eventHandlers.onClickBtnDelete.bind(o));
		},
		cacheDom: function () {
			var o = this;
			o.dom.$grid = $("#grid");
			o.dom.$editorUpload = $("#editorUpload");
			o.dom.$btnSaveUpload = $("#btnSaveUpload");
		},
		currentPeriode: "",
		currentRevisionNo: -1,
		data: {},
		dom: {},
		eventHandlers: {
			onClickBtnExcel: function () {
				var grid = this.dom.$grid.data('kendoGrid');
				if (grid) grid.saveAsExcel();
			},
			onClickBtnUpload: function () {
				var o = this;
				$("#fileUpload").data('kendoUpload').clearAllFiles();
				o.dom.$editorUpload.modal('show');
			},
			onClickBtnSaveUpload: function () {
				var o = this;

				var uploadFiles = $("#fileUpload").data('kendoUpload').getFiles();
				if (uploadFiles.length === 0) {
					swal.fire({title: 'Warning', text: 'Please select an Excel file.', icon: 'warning'});
					return;
				}

				swal.fire({
					title: 'Upload Data?',
					text: "The data in the uploaded file will be processed.",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, Upload'
				}).then((result) => {
					if (result.isConfirmed) {

						let formData = new FormData();
						let file = uploadFiles[0].rawFile;

						formData.append('file', file);

						$.ajax({
							url: "@myurl" + "CustomerOrder/Upload?UID=" + "@Context.Session.GetString("PIC_ID")",
							type: 'post',
							data: formData,
							contentType: false,
							processData: false,
							beforeSend: function () {
								swal.fire({
									title: 'Uploading...', allowOutsideClick: false, didOpen: () => {
										swal.showLoading()
									}
								});
							}
						}).done(function (data, textStatus, jqXHR) {
							var remarks = data[0].Remarks;
							var isPastPeriod = data[0].IsPastPeriod;

							if (remarks != '') {
								swal.fire({
									title: 'Validation Error',
									html: remarks,
									icon: 'error',
									width: '600px'
								});
								
							} else {
								o.dom.$editorUpload.modal('hide');

								if (isPastPeriod) {
									swal.fire({
										title: 'Success with Notice',
										html: 'Data successfully processed.<br/><br/><div style="background-color:#fcf8e3; border:1px solid #faebcc; padding:10px; color:#8a6d3b; text-align:left; font-size:12px; border-left:4px solid #f0ad4e;"><strong>NOTICE:</strong> Uploading or revising data for past periods is actually prohibited in production mode. This is permitted for testing workspace only.</div>',
										icon: 'warning'
									});
								} else {
									swal.fire({
										title: 'Success',
										text: 'Data successfully uploaded',
										icon: 'success',
										timer: 2000,
										showConfirmButton: false
									});
								}
								o.currentRevisionNo = -1;
								o.loadGridData(true);
							}
						}).always(function (data_or_jqXHR, textStatus, jqXHR_or_errorThrown) {
							$("#grid").data('kendoGrid').dataSource.read();
							$("#fileUpload").data('kendoUpload').clearAllFiles();
						});
					}
				});
			},
			onClickBtnDelete: function () {
				var o = this;

				swal.fire({
					title: 'Delete data?',
					html: '<div style="margin-bottom:10px;">Select the period to delete:</div><input id="PeriodeDelete" style="width:75%;" Placeholder="Select Period">',
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, Delete',
					cancelButtonText: 'Cancel',
					didOpen: () => {
						var today = new Date();
						var nextMonthDate = new Date(today.getFullYear(), today.getMonth() + 1, 1);

						$("#PeriodeDelete").kendoDatePicker({
							format: "yyyy-MM",
							value: today,
							//min: today,
							start: "year",
							depth: "year"
						});

						$("#PeriodeDelete").attr("readonly", true);
					},
					preConfirm: () => {
						var periodeDate = $("#PeriodeDelete").data('kendoDatePicker').value();

						if(!periodeDate) {
							swal.showValidationMessage('Period is required.');
							return false;
						}

						return periodeDate;
					},
				}).then((result) => {
					if (result.isConfirmed) {
						var periodeDate = result.value;
						var periodStr = kendo.toString(periodeDate, "yyyy-MM");

						var doDelete = function () {
							$.ajax({
								method: 'post',
								headers: {'Content-Type': 'application/json'},
								url: "@myurl" + 'CustomerOrder/Delete',
								dataType: 'json',
								data: JSON.stringify({
									Periode: periodStr
								}),
								beforeSend: function () {
									swal.fire({
										html: '<h5>Deleting data, please wait...</h5>',
										showConfirmButton: false,
										allowOutsideClick: false,
										closeOnClickOutside: false,
										didOpen: () => {
											Swal.showLoading();
										}
									});
								},
							}).done(function (data, textStatus, jqXHR) {
								var errorMsg = data.Remarks || data.remarks || '';

								if (errorMsg !== '') {
									swal.fire('Failed', errorMsg, 'error');
									return;
								}

								swal.fire({
									title: 'Success!',
									text: 'Deleted successfully.',
									icon: 'success',
									timer: 2000,
									showConfirmButton: false
								});

							}).fail(function (jqXHR, textStatus, errorThrown) {
								swal.fire('Error', errorThrown + (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
							}).always(function () {
								o.currentRevisionNo = -1;
								o.loadGridData(true);
							});
						};

						var today = new Date();
						var selectedYM = (periodeDate.getFullYear() * 100) + periodeDate.getMonth();
						var currentYM = (today.getFullYear() * 100) + today.getMonth();

						if (selectedYM <= currentYM) {
							swal.fire({
								title: 'Are you sure?',
								html: '<div style="text-align:left; font-size:13px;">' +
									'You have selected the current or a previous month.' +
									'<br/><br/>' +
									'<div style="background-color:#fdf2f2; border:1px solid #f2dede; padding:10px; color:#a94442; border-left:4px solid #d9534f; font-size:12px;">' +
									'<strong>REMINDER:</strong> Deleting data for current or past periods is strictly prohibited in production mode. This action is temporarily accessible for <strong>testing/trial purposes only</strong>.' +
									'</div>' +
									'<br/>Do you want to proceed with deletion anyway?</div>',
								icon: 'warning',
								showCancelButton: true,
								confirmButtonColor: '#f8c086',
								confirmButtonText: 'Yes, Proceed',
								cancelButtonText: 'Cancel'
							}).then((warningResult) => {
								if (warningResult.isConfirmed) {
									doDelete();
								}
							});
						} else {
							doDelete();
						}
					}
				});
			}
		},
		pivotData: function(rawData) {
			var grouped = {};
			rawData.forEach(function(item) {
				var key = item.Source + "_" + item.Suffix;
				if (!grouped[key]) {
					grouped[key] = {
						Periode: item.Periode,
						Source: item.Source,
						Suffix: item.Suffix
					};
				}
				grouped[key]["Day" + item.DayNumber] = item.ValueData;
			});

			return Object.keys(grouped).map(function(k) { return grouped[k]; });
		},
		loadGridData: function(skipLoading) {
			var o = this;
			var year = parseInt(o.currentPeriode.split('-')[0]);
			var month = parseInt(o.currentPeriode.split('-')[1]);
			var daysInMonth = new Date(year, month, 0).getDate();

			if (!skipLoading) {
				swal.fire({
					title: 'Loading...',
					allowOutsideClick: false,
					didOpen: () => {
						swal.showLoading();
					}
				});
			}

			$.ajax({
				method: 'post',
				headers: { 'Content-Type': 'application/json' },
				url: "@myurl" + 'CustomerOrder/GetRevisions',
				dataType: 'json',
				data: JSON.stringify({ Periode: o.currentPeriode })
			}).done(function (revisionList) {

				if (o.currentRevisionNo === -1) {
					if (revisionList && revisionList.length > 0) {
						o.currentRevisionNo = Math.max.apply(Math, revisionList);
					} else {
						o.currentRevisionNo = 0;
					}
				}

				$.ajax({
					method: 'post',
					headers: { 'Content-Type': 'application/json' },
					url: "@myurl" + 'CustomerOrder/INQ',
					dataType: 'json',
					data: JSON.stringify({ 
						Periode: o.currentPeriode, 
						RevisionNo: o.currentRevisionNo
					})
				}).done(function (data) {
					if (!skipLoading) {
						swal.close();
					}
					var pivotedData = o.pivotData(data);
					o.renderGrid(pivotedData, daysInMonth, revisionList);
				}).fail(function (jqXHR) {
					swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
				});

			}).fail(function (jqXHR) {
				swal.fire('Error Fetching Revisions', '', 'error');
			});
		},
		renderGrid: function(dataSourceData, daysInMonth, revisionList) {
			var o = this;
			var gridElem = o.dom.$grid;

			if (gridElem.data("kendoGrid")) {
				gridElem.data("kendoGrid").destroy();
				gridElem.empty();
			}

			var columns = [
				{ field: "Periode", title: "Period", width: 100, locked: true },
				{ field: "Source", title: "Source", width: 80, locked: true },
				{ field: "Suffix", title: "Suffix/Part Number", width: 150, locked: true }
			];

			var modelFields = {
				Periode: { type: "string" },
				Source: { type: "string" },
				Suffix: { type: "string" }
			};

			for (var i = 1; i <= daysInMonth; i++) {
				var fieldName = "Day" + i;
				columns.push({
					field: fieldName,
					title: i.toString(),
					width: 70,
					format: "{0:n2}",
					attributes: { style: "text-align: right;" }
				});
				modelFields[fieldName] = { type: "number" };
			}

			gridElem.kendoGrid({
				excel: { fileName: "Customer Order.xlsx", allPages: true },
				toolbar: $("#template_toolbar").html(),
				dataSource: {
					data: dataSourceData,
					pageSize: 20,
					schema: { model: { fields: modelFields } }
				},
				scrollable: true,
				sortable: true,
				resizable: true,
				filterable: {
					extra: false,
					operators: {
						string: {
							contains: "Contains",
							eq: "Equal to",
							neq: "Not equal to"
						}
					}
				},
				pageable: { 
					refresh: false, 
					pageSizes: true, 
					buttonCount: 5 
				},
				columns: columns
			});

			$("#FilterPeriode").kendoDatePicker({
				start: "year",
				depth: "year",
				format: "yyyy-MM",
				dateInput: true,
				value: o.currentPeriode,
				change: function() {
					var filterVal = kendo.toString(this.value(), "yyyy-MM");
					if (filterVal) {
						o.currentPeriode = filterVal;
						o.currentRevisionNo = -1;
						o.loadGridData(false);
					}
				}
			});

			var dropdownRevisionData = [];
			if (revisionList && revisionList.length > 0) {
				revisionList.forEach(function (rev) {
					dropdownRevisionData.push({
						Text: rev === 0 ? "Original" : "Revision " + rev,
						Value: rev
					});
				});
			}

			$("#FilterRevision").kendoDropDownList({
				dataTextField: "Text",
				dataValueField: "Value",
				dataSource: dropdownRevisionData,
				value: o.currentRevisionNo,
				change: function () {
					o.currentRevisionNo = parseInt(this.value());
					o.loadGridData(false);
				}
			});

			if (dropdownRevisionData.length <= 1) {
				$("#ContainerRevision").hide();
			} else {
				$("#ContainerRevision").show();
			}
		},
		init: function () {
			var o = this;
			o.cacheDom();
			o.attachEvents();
			o.initElements();
		},
		initElements: function () {
			var o = this;

			var now = new Date();
			o.currentPeriode = now.getFullYear() + "-" + ("0" + (now.getMonth() + 1)).slice(-2);

			$("#fileUpload").kendoUpload({
				multiple: false,
				validation: {
					allowedExtensions: [".xls", ".xlsx"]
				}
			});

			o.loadGridData(false);
		}
	};

	$(function () {
		AppD.init();
	});
</script>

<script type="text/x-kendo-template" id="template_toolbar">
	<span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Customer Order -&nbsp;&nbsp;</span>
	<div class="toolbar">
	
		<button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
			<i class="k-icon k-i-excel"></i>
		</button>
		
		@if (Context.Session.GetString("add_CustomerOrder") == "True")
		{
			<button data-toggle="tooltip" title="Upload" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
				<i class="k-icon k-i-upload"></i>
			</button>
		}
		
		@if (Context.Session.GetString("del_CustomerOrder") == "True")
		{
			<button data-toggle="tooltip" title="Delete Data" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnDelete">
			<i class="fa fa-trash"></i>
		</button>
		}
	
	</div>

	<div style="display: inline-block; margin-left: 20px;">
		<label>Filter Periode: </label>
		<input type="text" id="FilterPeriode" style="width: 150px;" />
	</div>

	<div id="ContainerRevision" style="display: inline-block; margin-left: 20px;">
		<label>Data Version: </label>
		<input type="text" id="FilterRevision" style="width: 130px;" />
	</div>
</script>