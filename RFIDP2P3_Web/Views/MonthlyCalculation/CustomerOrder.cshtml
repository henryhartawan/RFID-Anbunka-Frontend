@{
ViewData["Title"] = "Customer Order";
string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<style>
	.k-dropdown-wrap .k-input, .k-numeric-wrap .k-input, .k-picker-wrap .k-input { height: 30px; }

	.k-grid-header { padding-right: 0 !important; }
	.k-grid-content { overflow-y: auto; }

	.k-grid td {
		font-size: 11px !important;
		padding: 5px 8px !important;
		line-height: 1.2 !important;
	}
</style>

<div class="page-main">
	<div class="page-content padding-5">
		<div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
	</div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="padding-top:25vh;">
	<div class="" role="document" style="padding-left:25vw;">
		<div class="modal-content" style="width:50vw">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<h4 class="modal-title" id="myModalTitle">Upload Customer Order</h4>
			</div>
			<div class="modal-body margin-bottom-0 padding-bottom-0">
				<form id="formUpload" enctype="multipart/form-data" class="form-horizontal">

					<div class="form-group">
						<label class="col-sm-2 control-label" style="text-align:left;">File Excel</label>
						<div class="col-sm-10">
							<input type="file" name="file" id="fileUpload" accept=".xls,.xlsx" />
						</div>
					</div>

				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default" data-dismiss="modal" id='clear'>Close</button>
				<button type="button" class="btn btn-primary" id="btnSaveUpload">Upload</button>
			</div>
		</div>
	</div>
</div>

<script>
	var IUType = 'I';

	var AppD = {
		attachEvents: function () {
			var o = this;
			o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));

			o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
			o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
			o.dom.$grid.on('click', '#btnSearch', o.eventHandlers.onClickBtnSearch.bind(o));
		},
		cacheDom: function () {
			var o = this;
			o.dom.$grid = $("#grid");
			o.dom.$editorUpload = $("#editorUpload");
			o.dom.$btnSaveUpload = $("#btnSaveUpload");
		},
		currentPeriode: "", 
		data: {},
		dom: {},
		eventHandlers: {
			onClickBtnSearch: function () {
				var filterVal = $("#FilterPeriode").val();
				if (filterVal) this.currentPeriode = filterVal;
				this.loadGridData();
			},
			onClickBtnExcel: function () {
				var grid = this.dom.$grid.data('kendoGrid');
				if (grid) grid.saveAsExcel();
			},
			onClickBtnUpload: function () {
				var o = this;
				$("#fileUpload").data('kendoUpload').clearAllFiles();
				o.dom.$editorUpload.modal('show');
			},
			onClickBtnSaveUpload: function () {
				var o = this;

				var uploadFiles = $("#fileUpload").data('kendoUpload').getFiles();
				if (uploadFiles.length === 0) {
					swal.fire({title: 'Warning', text: 'Please select an Excel file.', icon: 'warning'});
					return;
				}

				swal.fire({
					title: 'Upload Data?',
					text: "The data in the uploaded file will be processed.",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, Upload'
				}).then((result) => {
					if (result.isConfirmed) {

						let formData = new FormData();
						let file = uploadFiles[0].rawFile;

						formData.append('file', file);

						$.ajax({
							url: "@myurl" + "CustomerOrder/Upload?UID=" + "@Context.Session.GetString("PIC_ID")",
							type: 'post',
							data: formData,
							contentType: false,
							processData: false,
							beforeSend: function () {
								swal.fire({
									title: 'Uploading...', allowOutsideClick: false, didOpen: () => {
										swal.showLoading()
									}
								});
							}
						}).done(function (data, textStatus, jqXHR) {
							var remarks = data[0].Remarks;

							if (remarks != '') {
								swal.fire({
									title: 'Validation Error',
									html: remarks,
									icon: 'error',
									width: '600px'
								});
								
							} else {
								o.dom.$editorUpload.modal('hide');
								swal.fire({
									title: 'Success',
									text: 'Data successfully uploaded',
									icon: 'success',
									timer: 2000,
									showConfirmButton: false
								});
								o.loadGridData();
							}
						}).always(function (data_or_jqXHR, textStatus, jqXHR_or_errorThrown) {
							$("#grid").data('kendoGrid').dataSource.read();
							$("#fileUpload").data('kendoUpload').clearAllFiles();
						});
					}
				});
			},
		},
		pivotData: function(rawData) {
			var grouped = {};
			rawData.forEach(function(item) {
				var key = item.Source + "_" + item.Suffix;
				if (!grouped[key]) {
					grouped[key] = {
						Periode: item.Periode,
						Source: item.Source,
						Suffix: item.Suffix
					};
				}
				grouped[key]["Day" + item.DayNumber] = item.ValueData;
			});

			return Object.keys(grouped).map(function(k) { return grouped[k]; });
		},
		loadGridData: function() {
			var o = this;
			var year = parseInt(o.currentPeriode.split('-')[0]);
			var month = parseInt(o.currentPeriode.split('-')[1]);
			var daysInMonth = new Date(year, month, 0).getDate();

			swal.fire({ title: 'Loading...', allowOutsideClick: false, didOpen: () => { swal.showLoading() } });

			$.ajax({
				method: 'post',
				headers: { 'Content-Type': 'application/json' },
				url: "@myurl" + 'CustomerOrder/INQ',
				dataType: 'json',
				data: JSON.stringify({ Periode: o.currentPeriode })
			}).done(function (data) {
				swal.close();
				var pivotedData = o.pivotData(data);
				o.renderGrid(pivotedData, daysInMonth);
			}).fail(function (jqXHR) {
				swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
			});
		},
		renderGrid: function(dataSourceData, daysInMonth) {
			var o = this;
			var gridElem = o.dom.$grid;

			if (gridElem.data("kendoGrid")) {
				gridElem.data("kendoGrid").destroy();
				gridElem.empty();
			}

			var columns = [
				{ field: "Periode", title: "Period", width: 100, locked: true },
				{ field: "Source", title: "Source", width: 80, locked: true },
				{ field: "Suffix", title: "Suffix", width: 150, locked: true }
			];

			var modelFields = {
				Periode: { type: "string" },
				Source: { type: "string" },
				Suffix: { type: "string" }
			};

			for (var i = 1; i <= daysInMonth; i++) {
				var fieldName = "Day" + i;
				columns.push({
					field: fieldName,
					title: i.toString(),
					width: 70,
					format: "{0:n2}",
					attributes: { style: "text-align: right;" }
				});
				modelFields[fieldName] = { type: "number" };
			}

			gridElem.kendoGrid({
				excel: { fileName: "Customer Order.xlsx", allPages: true },
				toolbar: $("#template_toolbar").html(),
				dataSource: {
					data: dataSourceData,
					pageSize: 20,
					schema: { model: { fields: modelFields } }
				},
				scrollable: true,
				sortable: true,
				resizable: true,
				filterable: {
					extra: false,
					operators: {
						string: {
							contains: "Contains",
							eq: "Equal to",
							neq: "Not equal to"
						}
					}
				},
				pageable: { 
					refresh: false, 
					pageSizes: true, 
					buttonCount: 5 
				},
				columns: columns
			});

			$("#FilterPeriode").kendoDatePicker({
				start: "year", depth: "year", format: "yyyy-MM", dateInput: true, value: o.currentPeriode
			});
		},
		init: function () {
			var o = this;
			o.cacheDom();
			o.attachEvents();
			o.initElements();
		},
		initElements: function () {
			var o = this;

			var now = new Date();
			o.currentPeriode = now.getFullYear() + "-" + ("0" + (now.getMonth() + 1)).slice(-2);

			$("#fileUpload").kendoUpload({
				multiple: false,
				validation: {
					allowedExtensions: [".xls", ".xlsx"]
				}
			});

			o.loadGridData();
		}
	};

	$(function () {
		AppD.init();
	});
</script>

<script type="text/x-kendo-template" id="template_toolbar">
	<span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Customer Order -&nbsp;&nbsp;</span>
	<div class="toolbar">
	
		@if (Context.Session.GetString("add_CustomerOrder") == "True")
		{
			<button data-toggle="tooltip" title="Upload" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
				<i class="k-icon k-i-upload"></i>
			</button>
		}
		<button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
			<i class="k-icon k-i-excel"></i>
		</button>
	</div>

	<div style="display: inline-block; margin-left: 20px;">
		<label>Filter Periode: </label>
		<input type="text" id="FilterPeriode" style="width: 150px;" />
		<button type="button" class="btn btn-primary btn-sm" id="btnSearch" style="margin-left: 5px;">Search</button>
	</div>
</script>