@{
	ViewData["Title"] = "Upload Initial Stock Engine";
	string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<div class="page-main">
	<div class="page-content padding-10">
		<div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
	</div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="padding-top:25vh;">
	<div class="" role="document" style="padding-left:25vw;">
		<div class="modal-content" style="width:50vw">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<h4 class="modal-title" id="myModalTitle">Upload Initial Stock Engine</h4>
			</div>
			<div class="modal-body margin-bottom-0 padding-bottom-0">
				<form id="formUpload" enctype="multipart/form-data">
					<span>Download template <a href="../../templates/Init Stock Engine.xlsx" style="color:#0099ff" download="Template Init Stock Engine.xlsx">here</a></span>
					<input type="file" name="file" class="form-control" id="fileUpload" accept=".xls,.xlsx" />
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default" data-dismiss="modal" id='clear'>Close</button>
				<button type="button" class="btn btn-primary" id="btnSaveUpload" value="Upload">Upload</button>
			</div>
		</div>
	</div>
</div>

<script>
	var AppD = {
		attachEvents: function () {
			var o = this;
			o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));
			o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
			o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
		},
		cacheDom: function () {
			var o = this;
			o.dom.$grid = $("#grid");
			o.dom.$editorUpload = $("#editorUpload");
			o.dom.$btnSaveUpload = $("#btnSaveUpload");
		},
		data: {
			Prod_Date: new Date()
		},
		dom: {},
		eventHandlers: {
			onClickBtnExcel: function () {
				var o = this;
				o.dom.$grid.data('kendoGrid').saveAsExcel();
			},
			onClickBtnUpload: function () {
				var o = this;
				var upload = $("#fileUpload").data("kendoUpload");
				if (upload) {
					upload.clearAllFiles();
				}
				o.dom.$editorUpload.modal('show');
			},
			onClickBtnSaveUpload: function () {
				var o = this;
				var upload = $("#fileUpload").data('kendoUpload');
				var files = upload.getFiles();

				if(files.length === 0){
					swal.fire({ title: 'Warning', text: 'Please select an Excel file first', icon: 'warning'});
					return;
				}

				swal.fire({
					title: 'Upload Stock Engine?',
					text: "Are you sure you want to upload this Excel file?",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, Upload it'
				}).then((result) => {
					if (result.isConfirmed) {
						let formData = new FormData();
						formData.append('file', files[0].rawFile);

						swal.fire({
							title: 'Uploading Data...',
							text: 'Please wait while we process your Excel file.',
							allowOutsideClick: false,
							didOpen: () => {
								swal.showLoading();
							}
						});

						$.ajax({
							url: "@myurl" + "UploadStockEngine/Upload?UID=" + "@Context.Session.GetString("PIC_ID")",
							type: 'post',
							data: formData,
							contentType: false,
							processData: false,
							success: function (response) {
								var isArrayResponse = Array.isArray(response);
								var remarks = isArrayResponse && response.length > 0 ? response[0].Remarks : response;

								if (remarks !== '' && remarks !== 'success') {
									swal.fire({
										title: 'Upload Failed!',
										html: remarks,
										icon: 'error'
									});
									upload.clearAllFiles();
								} else {
									o.dom.$editorUpload.modal('hide');
									swal.fire({ title: 'Success', text: 'Data Uploaded successfully!', icon: 'success', timer: 2000, showConfirmButton: false });
									o.dom.$grid.data('kendoGrid').dataSource.read();
									upload.clearAllFiles();
								}
							},
							error: function (jqXHR, textStatus, errorThrown) {
								var errorHtml = jqXHR.responseText !== '' ? jqXHR.responseText : 'Failed to connect to server.';
								swal.fire({
									title: 'Upload Cancelled!',
									html: errorHtml,
									icon: 'error'
								});
								upload.clearAllFiles();
							}
						});
					}
				});
			}
		},
		init: function () {
			var o = this;
			o.cacheDom();
			o.attachEvents();
			o.initElements();
		},
		initElements: function () {
			var o = this;

			o.dom.$grid.kendoGrid({
				excel: {
					fileName: "Stock Engine.xlsx",
					allPages: true,
					filterable: true
				},
				dataSource: {
					transport: {
						read: function (options) {
							$.ajax({
								method: 'post',
								headers: { 'Content-Type': 'application/json' },
								url: "@myurl"+'UploadStockEngine/INQ',
								dataType: 'text',
								data: JSON.stringify({
									Prod_Date: o.data.Prod_Date ? kendo.toString(o.data.Prod_Date, 'yyyy-MM') : ""
								})
							}).done(function (data, textStatus, jqXHR) {
								try {
									var result = JSON.parse(data);
								}
								catch (e) {
									swal.fire('Error', 'Error loading grid', 'error');
									console.log(data);
									options.success({ data: [] });
									return;
								}
								options.success(result);
							}).fail(function (jqXHR, textStatus, errorThrown) {
								swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
								console.log(jqXHR);
								options.success({ data: [] });
							});
						}
					},
					schema: {
						model: {
							id: "Unique",
							fields: {
								Periode_ID: { type: "string" },
								UniqueCode: { type: "string" },
								QtyLastStock: { type: "number" }
							}
						}
					},
					pageSize: 20
				},
				scrollable: true,
				sortable: true,
				resizable: true,
				reorderable: true,
				filterable: {
					extra: false,
					operators: {
						string: {
							contains: "Contains",
							eq: "Equal to",
							neq: "Not equal to"
						}
					}
				},
				pageable: {
					refresh: true,
					input: true,
					numeric: true,
					pageSizes: true,
					buttonCount: 5
				},
				columns: [
				{
					field: "Periode_ID",
					title: "Periode",
					width: 100,
				},
				{
					field: "UniqueCode",
					title: "Unique",
					width: 200,
					template: "<div class='customClass'> #= (UniqueCode == null) ? ' ' : kendo.toString(UniqueCode, '') # </div>",
				},
				{
					field: "QtyLastStock",
					title: "Qty",
					width: 100
				}],
				toolbar: $("#template_toolbar").html(),
				dataBound: function(e) {
					o.initAfter();
				}
			});

			$("#fileUpload").kendoUpload({
				multiple: false,
				validation: {
					allowedExtensions: [".xls", ".xlsx"],
					maxFileSize: 5242880
				},
				select: function(e) {
					$.each(e.files, function (index, value) {
						if (value.extension.toLowerCase() !== ".xls" && value.extension.toLowerCase() !== ".xlsx") {
							e.preventDefault();
							swal.fire({ title: 'Invalid File', text: 'Please upload a valid Excel file (.xls or .xlsx)', icon: 'error' });
						}
						else if (value.size > 5242880) {
							e.preventDefault();
							swal.fire({ title: 'File Too Large', text: 'Excel file size cannot exceed 5MB.', icon: 'error' });
						}
					});
				}
			});
		},
		initAfter: function(){
			var o = this;
			if (o.initAfterCalled) return;
			o.initAfterCalled = true;
			o.dom.Prod_Date = $("#Prod_Date");

			o.dom.Prod_Date.kendoDatePicker({
				start: "year",
				depth: "year", 
				format: "yyyy-MM",

				value: o.data.Prod_Date,
				change: function () {
					o.data.Prod_Date = this.value() != null ? this.value() : '';

					if(this.value()){
						o.dom.$grid.data('kendoGrid').dataSource.read();
					}
				}
			});
		}
	};

	$(function () {
		AppD.init();
	});
</script>

<script type="text/x-kendo-template" id="template_toolbar">
	<span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Upload Stock Engine -&nbsp;&nbsp;</span>
	<div class="toolbar">
		<button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
			<i class="k-icon k-i-excel"></i>
		</button>
		@if (Context.Session.GetString("add_UploadStockEngine") == "True")
		{
			<button data-toggle="tooltip" title="Upload" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
				<i class="k-icon k-i-upload"></i>
			</button>
		}
	
		&nbsp;&nbsp;
		<input type="text" id="Prod_Date" placeholder="Select Period" style="width: 150px;" />
	</div>
</script>
