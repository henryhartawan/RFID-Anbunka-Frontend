@{
    ViewData["Title"] = "Order DDMI";
    string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<style>
    
    .k-dropdown-wrap .k-input, 
    .k-numeric-wrap .k-input,
    .k-picker-wrap .k-input {
        height: 30px;
    }
    
    .k-grid-header {
        padding-right: 0 !important; 
    }
    
    .k-grid-content { 
        overflow-y: auto; 
    }
    
    .k-grid td { 
        font-size: 11px !important; 
        padding: 5px 8px !important; 
        line-height: 1.2 !important;
        white-space: nowrap;
    }
    
    .highlight-col { 
        background-color: #e8f5e9 !important; 
        font-weight: bold;
    }

    .wrap-text {
        white-space: pre-line !important;
        vertical-align: top !important;
        line-height: 1.5 !important;
    }
    
</style>

<div class="page-main">
    <div class="page-content padding-5">
        <div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
    </div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" style="padding-top:20vh;">
    <div role="document" style="padding-left:25vw;">
        <div class="modal-content" style="width:50vw">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Upload Daily Order DDMI</h4>
            </div>
            <div class="modal-body margin-bottom-0 padding-bottom-0">
                <form id="formUpload" enctype="multipart/form-data">
                    <input type="file" name="file" class="form-control" id="fileUpload" accept=".xls,.xlsx,.csv" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveUpload">Upload</button>
            </div>
        </div>
    </div>
</div>

<script>
    var AppD = {
        currentUploadDate: "",
        dom: {},
        init: function () {
            this.cacheDom();
            this.attachEvents();
            this.initElements();
        },
        cacheDom: function () {
            this.dom.$grid = $("#grid");
            this.dom.$editorUpload = $("#editorUpload");
            this.dom.$btnSaveUpload = $("#btnSaveUpload");
        },
        attachEvents: function () {
            var o = this;
            o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));
            o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
            o.dom.$grid.on('click', '#btnDelete', o.eventHandlers.onClickBtnDelete.bind(o));
            o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
        },
        eventHandlers: {
            onClickBtnExcel: function () {
                var grid = this.dom.$grid.data('kendoGrid');
                if (grid) grid.saveAsExcel();
            },
            onClickBtnUpload: function () {
                $("#fileUpload").data('kendoUpload').clearAllFiles();
                this.dom.$editorUpload.modal('show');
            },
            onClickBtnSaveUpload: function () {
                var o = this;
                var uploadFiles = $("#fileUpload").data('kendoUpload').getFiles();
                
                if (uploadFiles.length === 0) {
                    swal.fire('Warning', 'Please select a file to upload.', 'warning');
                    return;
                }

                let formData = new FormData();
                formData.append('file', uploadFiles[0].rawFile);

                swal.fire({
                    title: 'Upload Daily Order DDMI?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Upload'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "@myurl" + "OrderDdmi/Upload?UID=@Context.Session.GetString("PIC_ID")",
                            type: 'post',
                            data: formData,
                            contentType: false, 
                            processData: false,
                            beforeSend: function () {
                                swal.fire({
                                    title: 'Uploading...',
                                    text: 'Please wait while we process your data.',
                                    allowOutsideClick: false,
                                    didOpen: () => {
                                        swal.showLoading();
                                    }
                                });
                            }
                        }).done(function (response) {
                            var remarks = "";

                            if (Array.isArray(response) && response.length > 0) {
                                remarks = response[0].remarks || response[0].Remarks;
                            } else if (response) {
                                remarks = response.remarks || response.Remarks;
                            }

                            if (remarks && remarks !== '') {
                                swal.fire('Validation Warning', remarks, 'warning');
                            } else {
                                o.dom.$editorUpload.modal('hide');
                                
                                swal.fire({
                                    title: 'Success!',
                                    text: 'Data has been successfully uploaded and processed.',
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                
                                var grid = $("#grid").data("kendoGrid");
                                if(grid) grid.dataSource.read();
                            }
                        }).fail(function (jqXHR) {
                            swal.fire({
                                title: 'Upload Failed',
                                html: jqXHR.responseText,
                                icon: 'error',
                                width: '600px'
                            });
                        }).always(function () {
                            $("#fileUpload").data('kendoUpload').clearAllFiles();
                        });
                    }
                });
            },
            onClickBtnDelete: function() {
                var o = this;
                var todayDate = kendo.toString(new Date(), "yyyy-MM-dd");

                swal.fire({
                    title: 'Delete All Data?',
                    html: '<label style="margin-bottom: 10px;">Select the date to delete:</label><br>' +
                        '<input type="date" id="delDate" class="swal2-input" style="width: 80%;" value="' + todayDate + '">',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Delete',
                    preConfirm: () => {
                        var val = document.getElementById('delDate').value;
                        if (!val) {
                            swal.showValidationMessage('You must select a date first!');
                        }
                        return val;
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        var dateToDelete = result.value;
                        $.ajax({
                            url: "@myurl" + "OrderDdmi/Delete",
                            type: 'post',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                UploadDate: dateToDelete
                            })
                        }).done(function (data) {
                            if(data !== 'success'){
                                swal.fire('Failed', data, 'error');
                                return;
                            }
                            swal.fire({
                                title: 'Deleted!',
                                text: 'Data has been successfully deleted.',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            });

                            var grid = o.dom.$grid.data("kendoGrid");
                            if(grid) grid.dataSource.read();
                        }).fail(function( jqXHR, textStatus, errorThrown ) {
                            swal.fire('Error', errorThrown + (jqXHR.responseText !== '' ? jqXHR.responseText : ''), 'error');
                        });
                    }
                });
            }
        },
        initElements: function () {
            var o = this;
            var now = new Date();
            o.currentPeriode = kendo.toString(now, "yyyy-MM");

            $("#fileUpload").kendoUpload({
                multiple: false,
                validation: {
                    allowedExtensions: [".xls", ".xlsx", ".csv"]
                }
            });

            o.dom.$grid.kendoGrid({
                excel: {
                    fileName: "Order_DDMI_" + o.currentPeriode + ".xlsx",
                    allPages: true,
                    filterable: true
                },
                dataSource: {
                    transport: {
                        read: function (options) {
                            $.ajax({
                                method: 'post',
                                headers: { 'Content-Type': 'application/json' },
                                url: "@myurl" + 'OrderDdmi/INQ',
                                dataType: 'text',
                                data: JSON.stringify({
                                    Periode: o.currentPeriode
                                })
                            }).done(function (data, textStatus, jqXHR) {
                                try {
                                    var result = JSON.parse(data);
                                }
                                catch (e) {
                                    swal.fire('Error', 'Error parsing data', 'error');
                                    options.success({ Data: [], Total: 0 });
                                    return;
                                }
                                options.success(result);
                            }).fail(function (jqXHR, textStatus, errorThrown) {
                                swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
                                options.success({ Data: [], Total: 0 });
                            });
                        }
                    },
                    pageSize: 20,
                    schema: {
                        data: "Data",
                        total: "Total",
                        model: {
                            id: "PartNo",
                            fields: {
                                UploadDate: { type: "date" },
                                DnNo: { type: "string" },
                                SupplierCode: { type: "string" },
                                SupplierName: { type: "string" },
                                OrderDate: { type: "date" },
                                DeliveryDate: { type: "date" },
                                ItemNo: { type: "number" },
                                BackNo: { type: "string" },
                                PartNo: { type: "string" },
                                PartName: { type: "string" },
                                QtyPerBox: { type: "number" },
                                TotalQty: { type: "number" },
                                ActualKanban: { type: "number" }
                            }
                        }
                    }
                },
                scrollable: true,
                sortable: true,
                resizable: true,
                reorderable: true,
                filterable: {
                    extra: false,
                    operators: {
                        string: {
                            contains: "Contains",
                            eq: "Equal to",
                            neq: "Not equal to"
                        }
                    }
                },
                pageable: {
                    refresh: true,
                    pageSizes: true
                },
                columns: [
                    { 
                        field: "UploadDate", 
                        title: "Upload Date", 
                        width: 100, 
                        format: "{0:yyyy-MM-dd}", 
                    }, { 
                        field: "DnNo", 
                        title: "DN No", 
                        width: 220,
                    }, { 
                        field: "SupplierName", 
                        title: "Supplier Name",
                        width: 200 
                    }, { 
                        field: "OrderDate",
                        title: "Order Date", 
                        width: 100, 
                        format: "{0:yyyy-MM-dd}" 
                    }, {
                        field: "DeliveryDate",
                        title: "Deliv Date",
                        width: 100,
                        format: "{0:yyyy-MM-dd}" 
                    }, { 
                        field: "ItemNo", 
                        title: "No", 
                        width: 50, 
                    }, { 
                        field: "BackNo",
                        title: "Back No",
                        width: 80,
                    }, { 
                        field: "PartNo", 
                        title: "Part No",
                        width: 130,
                    }, { 
                        field: "PartName", 
                        title: "Part Name", 
                        width: 250 
                    }, { 
                        field: "QtyPerBox", 
                        title: "Qty/Box", 
                        width: 80, 
                    }, { 
                        field: "TotalQty", 
                        title: "Total Qty",
                        width: 90, 
                    }, { 
                        field: "ActualKanban", 
                        title: "Actual",
                        width: 80, 
                    }
                ],
                toolbar: kendo.template($("#template_toolbar").html()),
            });

            $("#FilterPeriode").kendoDatePicker({
                start: "year",
                depth: "year",
                format: "yyyy-MM",
                value: kendo.parseDate(o.currentPeriode, "yyyy-MM"),
                change: function() {
                    var selectedVal = kendo.toString(this.value(), "yyyy-MM");
                    if (selectedVal && selectedVal !== o.currentPeriode) {
                        o.currentPeriode = selectedVal;
                        var grid = o.dom.$grid.data("kendoGrid");
                        if(grid) {
                            grid.options.excel.fileName = "Order_DDMI_" + o.currentPeriode + ".xlsx";
                            grid.dataSource.read();
                        }
                    }
                }
            });
        }
    };

    $(function () { 
        AppD.init(); 
    });
</script>

<script type="text/x-kendo-template" id="template_toolbar">
    <span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Order DDMI -&nbsp;&nbsp;</span>
    <div class="toolbar">
        <button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
            <i class="k-icon k-i-excel"></i>
        </button>
       
        @if (Context.Session.GetString("add_OrderDdmi") == "True")
        {
            <button data-toggle="tooltip" title="Upload" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
                <i class="k-icon k-i-upload"></i>
            </button>
        }
       
        @if (Context.Session.GetString("del_OrderDdmi") == "True")
        {
            <button data-toggle="tooltip" title="Delete Data" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnDelete">
                <i class="fa fa-trash"></i>
            </button>
        }
       
        &nbsp;&nbsp;
        <input id="FilterPeriode" style="width: 150px; margin-right: 10px;" />
        &nbsp;&nbsp;
    </div>
</script>