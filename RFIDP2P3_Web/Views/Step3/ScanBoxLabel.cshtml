@{
	ViewData["Title"] = "Scan Box Label";
	string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<div id="qr_code" style="display:none;"></div>

<style>
	#qr-reader {
		margin-top: 30px;
	}

	#qr-reader__filescan_input {
		margin-left: 43%;
		margin-bottom: 30px;
	}

	#myModal {
		display: none;
		position: absolute;
		z-index: 9;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100%;
		height: 100%;
		overflow: auto;
		background-color: rgb(0, 0, 0);
		background-color: rgba(0, 0, 0, 0.4);
	}

	#myModal .modal-content {
		background-color: #fefefe;
		margin: auto;
		padding: 20px;
		border: 1px solid #888;
		width: 80%;
		height: 81vh;
	}

	.close {
		color: #aaaaaa;
		float: right;
		font-size: 28px;
		font-weight: bold;
	}

	.close:hover,
	.close:focus {
		color: #000;
		text-decoration: none;
		cursor: pointer;
	}
</style>

<div class="page-main">
	<div class="page-content padding-10">
		<div class="col-xs-12" style="height:70vh;">
			<div id="myModal" class="modal">
				<div class="modal-content">
					<span class="close">&times;</span>
					<div id="qr-reader"></div>
					<div id="qr-reader-results"></div>
				</div>
			</div>
			<div class="col-xs-0 col-md-2"></div>
			<div class="col-xs-12 col-md-8">
				<div class="col-xs-12">
					<h2><b>Scan Box Label</b></h2>
				</div>
				<div class="col-xs-11" style="padding-bottom:10px;padding-right:0px;">
					<label class="control-label" style="padding-bottom:0px;margin-bottom:0px;">Box Label</label>
					<input type="text" id="KanbanNo" onclick="this.select()" class="form-control" autofocus>
				</div>
				<div class="col-xs-1" style="padding-top:20px;padding-left:0px;">
					<button data-toggle="tooltip" title="Scan Box Label" type="button" class="camera col-sm-1 btn ink-reaction btn-floating-action btn-xs btn-info" id="btnBox">
						<i class="fa fa-camera" style="font-size:10pt;"></i>
					</button>
				</div>
				@if (Context.Session.GetString("add_ScanBoxLabel") == "True")
				{
					<div class="col-xs-12" style="padding-bottom:10px;">
						<button type="button" class="btn btn-primary" id="btnSubmit" style="width:100%;">Submit</button>
					</div>
				}
				<div class="col-xs-12" id="divGrid" style="padding-bottom:10px;">
					<div id="grid1" style="margin-left:0px;margin-top:0px;"></div>
				</div>
			</div>
			<div class="col-xs-0 col-md-2"></div>
		</div>
	</div>
</div>

<script src="~/js/jslib-html5-camera-photo.min.js"></script>
<script src="~/js/qrcode.min.js"></script>

<script>
	var AppD = {
		attachEvents: function() {
			var o = this;
			o.dom.$grid.on('click', '#btnClear', o.eventHandlers.onClickBtnClear.bind(o));
			o.dom.$btnBox.on('click', o.eventHandlers.onClickBtnTN.bind(o));
			o.dom.inputs.$inputBox.on('input', o.eventHandlers.onChangeBoxLabel.bind(o));
			o.dom.inputs.$inputBox.on('click', o.eventHandlers.onClickFocus.bind(o));
			o.dom.$btnSubmit.on('click', o.eventHandlers.onClickBtnSubmit.bind(o));
		},
		cacheDom: function() {
			var o = this;
			o.dom.inputs = {};
			o.dom.inputs.$inputBox = $("#KanbanNo");
			o.dom.$grid = $("#grid1");
			o.dom.$btnBox = $("#btnBox");
			o.dom.$btnSubmit = $("#btnSubmit");
		},
		data: {
			kanban: '',
			skid: []
		},
		dom: {},
		eventHandlers: {
			onClickBtnTN: function() {
				var modal = document.getElementById("myModal");
				modal.style.display = "block";

				Html5Qrcode.getCameras().then(devices => {
					if (devices && devices.length) {
						var cameraId = devices[0].id;
					}
				}).catch(err => {

				});

				function onScanSuccess(decodedText, decodedResult) {

				}

				function onScanFailure(error) {
					console.warn(`Code scan error = ${error}`);
				}

				const html5QrCode = new Html5Qrcode("qr-reader");
				const qrCodeSuccessCallback = (decodedText, decodedResult) => {
					if (decodedText !== decodedResult) {
						decodedResult = decodedText;

						document.getElementById("KanbanNo").value = decodedResult;
						$("#KanbanNo").trigger("input");
						html5QrCode.stop().then((ignore) => {

						}).catch((err) => {

						});
						document.getElementById("myModal").style.display = "none";
					}
				};
				const config = {
					fps: 10,
					qrbox: {
						width: 700,
						height: 350
					}
				};

				html5QrCode.start({
					facingMode: "environment"
				}, config, qrCodeSuccessCallback);

				html5QrcodeScanner.render(onScanSuccess);
			},
			onClickBtnSubmit: function(){
				var o = this;
				var data = {};
				data.UserLogin = "@Context.Session.GetString("PIC_ID")";

				var grid = o.dom.$grid.data("kendoGrid");
				var ds = grid.dataSource;

				var sort = ds.sort();
				var allData = ds.data().toJSON();

				if (sort && sort.length) {
					allData.sort(function (a, b) {
						for (var i = 0; i < sort.length; i++) {
							var field = sort[i].field;
							var dir = sort[i].dir === "asc" ? 1 : -1;

							if (a[field] > b[field]) return dir;
							if (a[field] < b[field]) return -dir;
						}
						return 0;
					});
				}

				data.Kanban = allData.map(function (e) {
					return {
						KanbanNo: e.KanbanNo,
						PI_No: e.PI_No,
						DN_No: e.DN_No,
						Part_No: e.Part_No,
						ExCore: e.ExCore,
						Job_No: e.Job_No,
						KanbanSeq: e.KanbanSeq
					};
				});

				if (data != null && data.Kanban.length > 0) {
					swal.fire({
						title: "Save?",
						icon: 'warning',
						showCancelButton: true,
						confirmButtonText: 'Yes'
					}).then((result) => {
						if (result.isConfirmed) {
							$.ajax({
								method: 'post',
								headers: { 'Content-Type': 'application/json', 'XApiKey': 'pgH7QzFHJx4w46fI~5Uzi4RvtTwlEXp' },
								url: "@myurl"+'ScanBoxLabel/INS',
								dataType: 'text',
								data: JSON.stringify(data)
							}).done(function(data, textStatus, jqXHR) {
								$("#btnClear").trigger('click');
								o.fn.printSKID.call(o, data);
							}).fail(function(jqXHR, textStatus, errorThrown) {
								swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
								console.log(jqXHR);
							}).always(function (data_or_jqXHR, textStatus, jqXHR_or_errorThrown) {
							});
						}
					});
				}
			},
			onChangeBoxLabel:function(e){
				var o = this;
				var kanban = $("#KanbanNo").val();

				if(kanban.length >= 33){
					o.data.kanban = kanban;
					$("#KanbanNo").val('');

					$.ajax({
						method: 'post',
						headers: { 'Content-Type': 'application/json', 'XApiKey': 'pgH7QzFHJx4w46fI~5Uzi4RvtTwlEXp' },
						url: "@myurl"+'ScanBoxLabel/CheckBox',
						dataType: 'text',
						data: JSON.stringify({
							KanbanNo: o.data.kanban
						})
					}).done(function(data, textStatus, jqXHR) {
						var result = JSON.parse(data);

						if(result[0].Remarks != 'success'){
							swal.fire('Error', result[0].Remarks, 'error');
						} else {
							var grid = $("#grid1").data("kendoGrid");
							var ds = grid.dataSource;
							result.forEach(x => {
								var exists = ds.data().some(d => 
									d.PI_No === x.PI_No &&
									d.DN_No === x.DN_No &&
									d.Part_No === x.Part_No &&
									d.ExCore === x.ExCore &&
									d.Job_No === x.Job_No &&
									d.KanbanSeq === x.KanbanSeq
								);
								if (!exists) {
									ds.add(x);
								}
							});
						}
					}).fail(function(jqXHR, textStatus, errorThrown) {
						swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
						console.log(jqXHR);
					});
				}
			},
			onClickFocus(e){$(e.target).select();},
			onClickBtnClear(e){
				var o = this;
				o.data.kanban = '';

				var grid = $("#grid1").data("kendoGrid");
				grid.dataSource.data([]);

				$("#KanbanNo").val('');
				$("#KanbanNo").select();
			},
		},
		fn: {
			printSKID: function(SKID_ID){
				var o = this;

				swal.fire({
					title: 'Success',
					text: 'Print SKID Label?',
					icon: 'success',
					showCancelButton: true,
					confirmButtonText: 'Yes',
					cancelButtonText: 'No',
					showLoaderOnConfirm: true,
					allowOutsideClick: false,
					allowEscapeKey: false,
					preConfirm: () => {
						return new Promise((resolve) => {
							setTimeout(() => {
								$.ajax({
									method: 'post',
									headers: { 'Content-Type': 'application/json', 'XApiKey': 'pgH7QzFHJx4w46fI~5Uzi4RvtTwlEXp' },
									url: "@myurl"+'ScanBoxLabel/PrintSKID',
									dataType: 'text',
									data: JSON.stringify({
										SKID_ID: SKID_ID
									})
								}).done(function(data, textStatus, jqXHR) {
									o.data.skid = JSON.parse(data);

									var x = 2.5;
									var y = 2.5;
									var no = 1;

									var pdf = new jsPDF({
										orientation: "p",
										unit: "mm",
										format: "a4"
									});

									pdf.setLineDash([0], 1);
									pdf.setLineWidth(0.1);

									pdf.rect(x, y, 205, 10);
									pdf.setFontSize(20);
									pdf.setFontStyle("bold");
									pdf.setTextColor(0, 0, 0);
									pdf.text("PT. ADM ENGINE PLANT", x + 102.5, y + 7.5, "center");

									y += 10;
									pdf.rect(x, y, 51.25, 8);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("VENDOR CODE", x + 1, y + 3.5);

									x += 51.25;
									pdf.rect(x, y, 102.5, 8);
									pdf.setFontSize(11.5);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].SupplierCode, x + 1, y + 5.5);

									x += 102.5;
									pdf.rect(x, y, 51.25, 8);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("PACKING GROUP", x + 1, y + 3.5);

									x = 2.5;
									y += 8;
									pdf.rect(x, y, 51.25, 8);
									pdf.text("VENDOR NAME", x + 1, y + 3.5);

									x += 51.25;
									pdf.rect(x, y, 102.5, 8);
									pdf.setFontSize(11.5);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].SupplierName, x + 1, y + 5.5);

									x += 102.5;
									pdf.rect(x, y, 51.25, 8);
									pdf.setFontSize(11.5);
									pdf.text(o.data.skid[0].Packaging_Group, x + 25.625, y + 5.5, "center");

									x = 2.5;
									y += 9;
									pdf.rect(x, y, 51.25, 12);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("DOCK :", x + 1, y + 3.5);
									pdf.setFontSize(16);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].Doc_Code, x + 25.625, y + 10, "center");

									x += 51.25;
									pdf.rect(x, y, 51.25, 12);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("LINE :", x + 1, y + 3.5);
									pdf.setFontSize(16);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].LineOrderCode, x + 25.625, y + 10, "center");

									x += 51.25;
									pdf.rect(x, y, 102.5, 12);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("DN NO :", x + 1, y + 3.5);
									pdf.setFontSize(16);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].DN_No, x + 1, y + 10);

									x = 2.5;
									y += 13;
									pdf.rect(x, y, 51.25, 11);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("DELIVERY DATE :", x + 1, y + 3.5);
									pdf.setFontSize(12);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].DeliveryDate, x + 25.625, y + 9, "center");

									x += 51.25;
									pdf.rect(x, y, 51.25, 11);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("CYCLE :", x + 1, y + 3.5);
									pdf.setFontSize(16);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].CycleArrival.toString(), x + 25.625, y + 9, "center");

									x += 51.25;
									pdf.rect(x, y, 51.25, 11);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("LANE NO :", x + 1, y + 3.5);
									pdf.setFontSize(16);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].Lane_No.toString(), x + 25.625, y + 9, "center");

									x += 51.25;
									pdf.rect(x, y, 51.25, 11);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("ARRIVAL TIME :", x + 1, y + 3.5);
									pdf.setFontSize(14);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].TimeArrival, x + 25.625, y + 9, "center");

									x = 2.5;
									y += 11;
									pdf.rect(x, y, 51.25, 33);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("SKID NO :", x + 1, y + 3.5);

									x += 51.25;
									pdf.rect(x, y, 76.875, 33);

									$("#qr_code").html("");
									$('#qr_code').qrcode(o.data.skid[0].SKID_ID);
									var canvas = document.querySelector("#qr_code canvas");
									var img = canvas.toDataURL("image/jpeg", 1);
									pdf.addImage(img, 'png', x + 23, y + 1.5, 30, 30, "center");

									x += 76.875;
									pdf.rect(x, y, 76.875, 11);
									pdf.setFontSize(7);
									pdf.text("SKID ID :", x + 1, y + 3.5);
									pdf.setFontSize(12);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].SKID_ID, x + 1, y + 9);

									y += 11;
									pdf.rect(x, y, 76.875, 11);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("ROUTE :", x + 1, y + 3.5);
									pdf.setFontSize(12);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].Group_Route, x + 1, y + 9);

									y += 11;
									pdf.rect(x, y, 76.875, 11);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("PI NUMBER :", x + 1, y + 3.5);
									pdf.setFontSize(12);
									pdf.setFontStyle("bold");
									pdf.text(o.data.skid[0].PI_No, x + 1, y + 9);

									x = 2.5;
									y += 11;
									pdf.rect(x, y, 205, 5);
									pdf.setFontSize(7);
									pdf.setFontStyle("normal");
									pdf.text("CONTENT LIST :", x + 1, y + 3.5);

									x = 2.5;
									y += 5;
									pdf.rect(x, y, 25.625, 5);
									pdf.text("NO", x + 12.8125, y + 3.5, "center");

									x += 25.625;
									pdf.rect(x, y, 51.25, 5);
									pdf.text("EXCORE", x + 25.625, y + 3.5, "center");

									x += 51.25;
									pdf.rect(x, y, 25.625, 5);
									pdf.text("JOB NO", x + 12.8125, y + 3.5, "center");

									x += 25.625;
									pdf.rect(x, y, 76.875, 5);
									pdf.text("PART NAME", x + 38.4375, y + 3.5, "center");

									x += 76.875;
									pdf.rect(x, y, 25.625, 5);
									pdf.text("QTY (BOX)", x + 12.8125, y + 3.5, "center");

									for(let i = 0; i < 39; i++) {
										x = 2.5;
										y += 5;
										pdf.rect(x, y, 25.625, 5);
										x += 25.625;
										pdf.rect(x, y, 51.25, 5);
										x += 51.25;
										pdf.rect(x, y, 25.625, 5);
										x += 25.625;
										pdf.rect(x, y, 76.875, 5);
										x += 76.875;
										pdf.rect(x, y, 25.625, 5);

										if(i < o.data.skid.length) {
											x = 2.5;
											pdf.text(no.toString(), x + 12.8125, y + 3.5, "center");
											x += 25.625;
											pdf.text(o.data.skid[i].ExCore, x + 1, y + 3.5);
											x += 51.25;
											pdf.text(o.data.skid[i].Job_No, x + 1, y + 3.5);
											x += 25.625;
											pdf.text(o.data.skid[i].Part_Name, x + 1, y + 3.5);
											x += 76.875;
											pdf.text(o.data.skid[i].QtyBox.toString(), x + 12.8125, y + 3.5, "center");

											no++;
										}
									}

									pdf.save('SKID Label ' + o.data.skid[0].SKID_ID + '.pdf');

									swal.close();
								}).fail(function(jqXHR, textStatus, errorThrown) {
									swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
									console.log(jqXHR);
								}).always(function (data_or_jqXHR, textStatus, jqXHR_or_errorThrown) {
								});
							}, 1000);
						});
					}
				});
			}
		},
		init: function() {
			var o = this;
			o.cacheDom();
			o.attachEvents();
			o.initElements();
		},
		initElements: function() {
			var o = this;

			o.dom.$grid.kendoGrid({
				height:350,
				dataSource: {
					data: [],
					pageSize: 10,
					sort: [
						{ field: "PI_No", dir: "asc" },
						{ field: "DN_No", dir: "asc" },
						{ field: "ExCore", dir: "asc" },
						{ field: "Job_No", dir: "asc" },
						{ field: "KanbanSeq", dir: "asc" }
					],
					aggregate: [{ field: "KanbanSeq", aggregate: "count" }]
				},
				scrollable: true,
				pageable: true,
				columns: [
					{
						field: "PI_No",
						title: "PI No.",
						width: 100,
						template: "<div class='customClass text-center'> #= (PI_No == null) ? ' ' : kendo.toString(PI_No, '') # </div>",
						footerTemplate: "Total Box"
					},
					{
						field: "DN_No",
						title: "DN No.",
						width: 100,
						template: "<div class='customClass text-center'> #= (DN_No == null) ? ' ' : kendo.toString(DN_No, '') # </div>",
					},
					{
						field: "ExCore",
						title: "Ex Core",
						width: 80,
						template: "<div class='customClass text-center'> #= (ExCore == null) ? ' ' : kendo.toString(ExCore, '') # </div>",
					},
					{
						field: "Job_No",
						title: "Job No.",
						width: 50,
						template: "<div class='customClass text-center'> #= (Job_No == null) ? ' ' : kendo.toString(Job_No, '') # </div>",
					},
					{
						field: "KanbanSeq",
						title: "Seq",
						width: 30,
						template: "<div class='customClass text-center'> #= (KanbanSeq == null) ? ' ' : kendo.toString(KanbanSeq, '') # </div>",
						aggregates: ["count"],
						footerTemplate: "<div class='text-center'><span style=\'float:center;font-size: 11px\'>#=(count == null) ? '0' : count#</span></div>",
					},
					{
						field: "Part_No",
						hidden: true
					},
					{
						field: "KanbanNo",
						hidden: true
					},
				],
				toolbar: $("#template_toolbar").html(),
			});

			$("#KanbanNo").val('');
			$("#KanbanNo").select();
		},
	};

	$(function() {
		AppD.init();
	});

	var modal = document.getElementById("myModal");
	var span = document.getElementsByClassName("close")[0];
	span.onclick = function() {
		modal.style.display = "none";
	}
	window.onclick = function(event) {
		if (event.target == modal) {
			modal.style.display = "none";
		}
	}
</script>

<script type="text/x-kendo-template" id="template_toolbar">
	<div class="toolbar">
		<button data-toggle="tooltip" title="Clear" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnClear">
			<i class="k-icon k-i-trash"></i>
		</button>
	</div>
</script>
