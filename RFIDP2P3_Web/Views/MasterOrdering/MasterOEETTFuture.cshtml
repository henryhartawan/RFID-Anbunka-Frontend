@{
	ViewData["Title"] = "Master OEE TT Future";
	string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<style>
	.k-dropdown-wrap .k-input, .k-numeric-wrap .k-input, .k-picker-wrap .k-input {
		height: 30px;
	}
</style>

<div class="page-main">
	<div class="page-content padding-5">
		<div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
	</div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="padding-top:25vh;">
	<div class="" role="document" style="padding-left:25vw;">
		<div class="modal-content" style="width:50vw">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<h4 class="modal-title" id="myModalTitle">Upload Master OEE TT Future</h4>
			</div>
			<div class="modal-body margin-bottom-0 padding-bottom-0">
				<form id="formUpload" enctype="multipart/form-data">
					<span>Download template <a href="../../templates/Master OEE TT Future.xlsx" style="color:#0099ff" download="Template Master OEE TT Future.xlsx">here</a></span>
					<input type="file" name="file" class="form-control" id="fileUpload" accept=".xls,.xlsx" />
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default" data-dismiss="modal" id='clear'>Close</button>
				<button type="button" class="btn btn-primary" id="btnSaveUpload">Upload</button>
			</div>
		</div>
	</div>
</div>

<script>
	var IUType = 'I';
	var exCore = '';

	var AppD = {
		attachEvents: function () {
			var o = this;
			o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));

			o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
			o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
			o.dom.$grid.on('click', '#btnSearch', o.eventHandlers.onClickBtnSearch.bind(o));
		},
		cacheDom: function () {
			var o = this;
			o.dom.$grid = $("#grid");
			o.dom.$editorUpload = $("#editorUpload");
			o.dom.$btnSaveUpload = $("#btnSaveUpload");
		},
		currentPeriode: "",
		data: {},
		dom: {},
		loadGridData: function () {
			if (this.dom.$grid.data('kendoGrid')) {
				this.dom.$grid.data('kendoGrid').dataSource.read();
			}
		},
		eventHandlers: {
			onClickBtnSearch: function () {
				var filterVal = $("#FilterPeriode").val();
				if (filterVal) this.currentPeriode = filterVal;
				this.loadGridData();
			},
			onClickBtnExcel: function () {
				var grid = this.dom.$grid.data('kendoGrid');
				if (grid) grid.saveAsExcel();
			},
			onClickBtnUpload: function () {
				var o = this;
				$("#fileUpload").data('kendoUpload').clearAllFiles();
				o.dom.$editorUpload.modal('show');
			},
			onClickBtnSaveUpload: function () {
				var o = this;

				var uploadFiles = $("#fileUpload").data('kendoUpload').getFiles();
				if (uploadFiles.length === 0) {
					swal.fire({title: 'Warning', text: 'Please select an Excel file.', icon: 'warning'});
					return;
				}

				swal.fire({
					title: 'Upload Data?',
					text: "The data in the uploaded file will be processed.",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, Upload'
				}).then((result) => {
					if (result.isConfirmed) {

						let formData = new FormData();
						let file = uploadFiles[0].rawFile;

						formData.append('file', file);

						$.ajax({
							url: "@myurl" + "MasterOEETTFuture/Upload?UID=" + "@Context.Session.GetString("PIC_ID")",
							headers: {'XApiKey': 'pgH7QzFHJx4w46fI~5Uzi4RvtTwlEXp'},
							type: 'post',
							data: formData,
							contentType: false,
							processData: false,
							beforeSend: function () {
								swal.fire({
									title: 'Uploading...', allowOutsideClick: false, didOpen: () => {
										swal.showLoading()
									}
								});
							}
						}).done(function (data) {

							o.dom.$editorUpload.modal('hide');
							swal.fire({
								title: 'Success',
								text: 'Data successfully uploaded',
								icon: 'success',
								timer: 2000,
								showConfirmButton: false
							});
							o.loadGridData();
						}).fail(function (jqXHR) {
							swal.fire({
								title: 'Validation Error',
								html: jqXHR.responseText,
								icon: 'error',
								width: '600px'
							});
						}).always(function () {
							$("#fileUpload").data('kendoUpload').clearAllFiles();
						});
					}
				});
			},
		},
		init: function () {
			var o = this;
			o.cacheDom();
			o.attachEvents();
			o.initElements();
		},
		initElements: function () {
			var o = this;

			o.dom.$grid.kendoGrid({
				excel: {
					fileName: "Master OEE TT Future.xlsx",
					allPages: true,
					filterable: true
				},
				dataSource: {
					transport: {
						read: function (options) {
							var periodVal = $("#FilterPeriode").val();

							if (!periodVal) {
								var d = new Date();
								var month = '' + (d.getMonth() + 1);
								var year = d.getFullYear();
								if (month.length < 2) month = '0' + month;

								periodVal = year + '-' + month;
							}

							var payload = {
								PeriodMonth: periodVal
							};
							
							$.ajax({
								method: 'post',
								headers: { 'Content-Type': 'application/json', 'XApiKey': 'pgH7QzFHJx4w46fI~5Uzi4RvtTwlEXp' },
								url: "@myurl"+'MasterOEETTFuture/INQ',
								dataType: 'text',
								data: JSON.stringify(payload)
							}).done(function (data, textStatus, jqXHR) {
								try {
									var result = JSON.parse(data);
								}
								catch (e) {
									swal.fire('Error', 'Error loading grid', 'error');
									options.success({ data: [] });
									return;
								}
								options.success(result);
							}).fail(function (jqXHR, textStatus, errorThrown) {
								swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
								options.success({ data: [] });
							});
						}
					},
					schema: {
						model: {
							id: "ExCore",
							fields: {
								ExCore: { type: "string" },
								Periode: { type: "string" },
								Line: { type: "string" },
								OEE: { type: "string" },
								CT: { type: "string" },
								OEETTStatus: { type: "string" },
								LastUpdate: { type: "string" },
								UserUpdate: { type: "string" },
								Remarks: { type: "string" },
							}
						}
					},
					pageSize: 20
				},
				scrollable: true,
				sortable: true,
				resizable: true,
				reorderable: true,
				filterable: {
					extra: false,
					operators: {
						string: {
							contains: "Contains",
							eq: "Equal to",
							neq: "Not equal to"
						}
					}
				},
				pageable: {
					refresh: true,
					input: true,
					numeric: true,
					pageSizes: true,
					buttonCount: 5
				},
				columns: [
				{
					field: "ExCore",
					title: "ID",
					width: 50
				}, {
					field: "Periode",
					title: "Periode",
					width: 150,
					template: "<div class='customClass'> #= (Periode == null) ? ' ' : kendo.toString(Periode, '') # </div>",
				}, {
					field: "Line",
					title: "Line",
					width: 150,
					template: "<div class='customClass'> #= (Line == null) ? ' ' : kendo.toString(Line, '') # </div>",
				}, {
					field: "OEE",
					title: "OEE",
					width: 100,
				}, {
					field: "CT",
					title: "CT (menit)",
					width: 100,
				}, {
					field: "OEETTStatus",
					title: "Status",
					width: 100
				}, {
					title: "Last Update",
					columns: [
					{
						field: "UserUpdate",
						title: "User",
						width: 100
					},
					{
						field: "LastUpdate",
						title: "Date",
						width: 150
					}]
				}],
				toolbar: $("#template_toolbar").html(),
				dataBound: function(e) {
				}
			});

			$("#FilterPeriode").kendoDatePicker({
				start: "year",
				depth: "year",
				format: "yyyy-MM",
				dateInput: true,
				value: new Date()
			});

			$("#fileUpload").kendoUpload({
				multiple: false,
				validation: {
					allowedExtensions: [".xls", ".xlsx"],
					maxFileSize: 5242880
				},
				select: function(e) {
					$.each(e.files, function (index, value) {
						if (value.extension.toLowerCase() !== ".xls" && value.extension.toLowerCase() !== ".xlsx") {
							e.preventDefault();
							swal.fire({ title: 'Invalid File', text: 'Please upload a valid Excel file (.xls or .xlsx)', icon: 'error' });
						}
						else if (value.size > 5242880) {
							e.preventDefault();
							swal.fire({ title: 'File Too Large', text: 'Excel file size cannot exceed 5MB.', icon: 'error' });
						}
					});
				}
			});
		}
	};

	$(function () {
		AppD.init();
	});
</script>

<script type="text/x-kendo-template" id="template_toolbar">
	<span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Master OEE TT Future -&nbsp;&nbsp;</span>
	<div class="toolbar">
		<button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
			<i class="k-icon k-i-excel"></i>
		</button>
		<button data-toggle="tooltip" title="Upload" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
			<i class="k-icon k-i-upload"></i>
		</button>
	</div>
	
	<div style="display: inline-block; margin-left: 20px;">
		<label>Filter Periode: </label>
		<input type="text" id="FilterPeriode" style="width: 150px;" />
		<button type="button" class="btn btn-primary btn-sm" id="btnSearch" style="margin-left: 5px;">Search</button>
	</div>
</script>
