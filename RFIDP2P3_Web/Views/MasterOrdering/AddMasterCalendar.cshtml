@{
	ViewData["Title"] = "Additional Master Calendar";
	string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<div class="page-main">
	<div class="page-content padding-10">
		<div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
	</div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="padding-top:25vh;">
	<div class="" role="document" style="padding-left:25vw;">
		<div class="modal-content" style="width:50vw">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-label="Close">
					<span aria-hidden="true">&times;</span>
				</button>
				<h4 class="modal-title" id="myModalTitle">Upload Customer Order</h4>
			</div>
			<div class="modal-body margin-bottom-0 padding-bottom-0">
				<form id="formUpload" enctype="multipart/form-data" class="form-horizontal">
                
					<div class="form-group">
						<label class="col-sm-3 control-label" style="text-align:left;">Periode</label>
						<div class="col-sm-9">
							<input type="text" id="PeriodeUpload" style="width: 100%;" required />
						</div>
					</div>

					<div class="form-group">
						<label class="col-sm-3 control-label" style="text-align:left;">File Excel</label>
						<div class="col-sm-9">
							<input type="file" name="file" id="fileUpload" accept=".xls,.xlsx" />
						</div>
					</div>

					<div class="form-group">
						<div class="col-sm-12">
							<span>Download template <a href="#" id="btnDownloadTemplate" style="color:#0099ff">here</a></span>
						</div>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-default" data-dismiss="modal" id='clear'>Close</button>
				<button type="button" class="btn btn-primary" id="btnSaveUpload">Upload</button>
			</div>
		</div>
	</div>
</div>

<script>
	var AppD = {
		attachEvents: function () {
			var o = this;
			o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));
			o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
			o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
			
			o.dom.$editorUpload.on('click', '#btnDownloadTemplate', o.eventHandlers.onClickBtnDownloadTemplate.bind(o));
		},
		cacheDom: function () {
			var o = this;
			o.dom.$grid = $("#grid");
			o.dom.$editorUpload = $("#editorUpload");
			o.dom.$btnSaveUpload = $("#btnSaveUpload");
		},
		data: {
			Prod_Date: new Date()
		},
		dom: {},
		eventHandlers: {
			onClickBtnExcel: function () {
				var o = this;
				var grid = this.dom.$grid.data('kendoGrid');
				if (grid) grid.saveAsExcel();
			},
			onClickBtnUpload: function () {
				var o = this;
				var upload = $("#fileUpload").data("kendoUpload");
				if (upload) {
					upload.clearAllFiles();
				}

				var periodePicker = $("#PeriodeUpload").data("kendoDatePicker");
				if(periodePicker) {
					periodePicker.value(new Date());
				}

				o.dom.$editorUpload.modal('show');
			},
			onClickBtnDownloadTemplate: function (e) {
				e.preventDefault();
				var o = this;

				var dpPeriode = $("#PeriodeUpload").data("kendoDatePicker");
				var selectedDateValue = dpPeriode.value();

				if (!selectedDateValue) {
					swal.fire('Warning', 'Please select a period first.', 'warning');
					return;
				}
				var selectedMonth = kendo.toString(selectedDateValue, 'yyyy-MM');

				swal.fire({
					title: 'Generating Template...', allowOutsideClick: false, didOpen: () => {
						swal.showLoading()
					}
				});

				fetch("/ApiProxy/Forward/AddMasterCalendar/DownloadTemplate?periode=" + selectedMonth, {
					method: 'GET',
				}).then(response => response.blob()).then(blob => {
					swal.close();
					var url = window.URL.createObjectURL(blob);
					var a = document.createElement('a');
					a.href = url;
					a.download = "Template_Calendar_" + selectedMonth + ".xlsx";
					a.click();
				});
			},
			onClickBtnSaveUpload: function () {
				var o = this;
				var upload = $("#fileUpload").data('kendoUpload');
				var files = upload.getFiles();

				var dpPeriode = $("#PeriodeUpload").data("kendoDatePicker");
				var selectedDateValue = dpPeriode.value();

				if (!selectedDateValue) {
					swal.fire({ title: 'Warning', text: 'Please select a period first', icon: 'warning'});
					return;
				}
				
				if(files.length === 0){
					swal.fire({ title: 'Warning', text: 'Please select an Excel file first', icon: 'warning'});
					return;
				}

				var selectedMonth = kendo.toString(selectedDateValue, 'yyyy-MM');

				swal.fire({
					title: 'Additional Master Calendar?',
					text: "Are you sure you want to upload this Excel file?",
					icon: 'warning',
					showCancelButton: true,
					confirmButtonText: 'Yes, Upload it'
				}).then((result) => {
					if (result.isConfirmed) {
						let formData = new FormData();
						formData.append('file', files[0].rawFile);
						formData.append('Periode', selectedMonth);

						$.ajax({
							url: "@myurl" + "AddMasterCalendar/Upload?UID=" + "@Context.Session.GetString("PIC_ID")",
							type: 'post',
							data: formData,
							contentType: false,
							processData: false,
							beforeSend: function () {
								swal.fire({
									title: 'Uploading...',
									text: 'Please wait while we process your Excel file.',
									allowOutsideClick: false, 
									didOpen: () => {
										swal.showLoading()
									}
								});
							}
						}).done(function (data, textStatus, jqXHR) {
							var remarks = (data && data.length > 0) ? data[0].Remarks : data.Remarks;

							if (remarks !== '' && remarks !== 'success') {
								swal.fire({title: 'Validation Error', text: remarks, icon: 'error'});
							} else {
								o.dom.$editorUpload.modal('hide');
								swal.fire({
									title: 'Success',
									text: 'Data successfully uploaded',
									icon: 'success',
									timer: 2000,
									showConfirmButton: false
								});
								o.currentPeriode = selectedMonth;
								if (typeof o.loadGridData === "function") {
									o.loadGridData();
								}
							}
						}).always(function (data_or_jqXHR, textStatus, jqXHR_or_errorThrown) {
							$("#grid").data('kendoGrid').dataSource.read();
							$("#fileUpload").data('kendoUpload').clearAllFiles();
						});
					}
				});
			}
		},
		init: function () {
			var o = this;
			o.cacheDom();
			o.attachEvents();
			o.initElements();
		},
		initElements: function () {
			var o = this;

			o.dom.$grid.kendoGrid({
				excel: {
					fileName: "Additional Master Calendar.xlsx",
					allPages: true,
					filterable: true
				},
				dataSource: {
					transport: {
						read: function (options) {
							$.ajax({
								method: 'post',
								headers: { 'Content-Type': 'application/json' },
								url: "@myurl"+'AddMasterCalendar/INQ',
								dataType: 'text',
								data: JSON.stringify({
									ProdDate: o.data.Prod_Date ? kendo.toString(o.data.Prod_Date, 'yyyy-MM-dd') : ""
								})
							}).done(function (data, textStatus, jqXHR) {
								try {
									var result = JSON.parse(data);
								}
								catch (e) {
									swal.fire('Error', 'Error loading grid', 'error');
									console.log(data);
									options.success({ data: [] });
									return;
								}
								options.success(result);
							}).fail(function (jqXHR, textStatus, errorThrown) {
								swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
								console.log(jqXHR);
								options.success({ data: [] });
							});
						}
					},
					schema: {
						model: {
							id: "CalendarId",
							fields: {
								CalendarId: { type: "string" },
								Line: { type: "string" },
								CalendarDate: { type: "date" },
								Shift: { type: "string" },
								CalendarStatus: { type: "string" },
								WorkingTime: { type: "number" },
								OEE: { type: "number" },
								CT: { type: "number" },
								EarlyOvertime: { type: "number" },
								EndOvertime: { type: "number" },
								MandatoryPdt: { type: "number" },
								OtherPdt: { type: "number" },
								TimePdt: { type: "number" },
								ProductionTarget: { type: "number" },
								CreatedBy: { type: "string" },
								CreatedDate: { type: "date" },
								UpdatedBy: { type: "string" },
								UpdatedDate: { type: "date" },
								Remarks: { type: "string" },
							}
						}
					},
					pageSize: 20
				},
				scrollable: true,
				sortable: true,
				resizable: true,
				reorderable: true,
				filterable: {
					extra: false,
					operators: {
						string: {
							contains: "Contains",
							eq: "Equal to",
							neq: "Not equal to"
						}
					}
				},
				pageable: {
					refresh: true,
					input: true,
					numeric: true,
					pageSizes: true,
					buttonCount: 5
				},
				columns: [
					{
						field: "CalendarId",
						title: "ID",
						width: 50
					}, {
						field: "Line",
						title: "Line",
						width: 200,
						template: "<div class='customClass'> #= (Line == null) ? ' ' : kendo.toString(Line, '') # </div>",
					}, {
						field: "CalendarDate",
						title: "Date",
						width: 100,
						template: "#= CalendarDate ? kendo.toString(kendo.parseDate(CalendarDate), 'yyyy-MM-dd') : '' #"
					}, {
						field: "Shift",
						title: "Shift",
						width: 100,
					}, {
						field: "CalendarStatus",
						title: "Status",
						width: 100
					},  {
						field: "WorkingTime",
						title: "Working Time",
						width: 150
					},  {
						field: "OEE",
						title: "OEE",
						width: 100,
						template: "<div style='text-align: right;'>#= kendo.toString(OEE, 'n2') # %</div>"
					},  {
						field: "CT",
						title: "CT",
						width: 100
					}, {
						field: "EarlyOvertime",
						title: "Early Overtime",
						width: 150
					}, {
						field: "EndOvertime",
						title: "End Overtime",
						width: 150
					}, {
						field: "MandatoryPdt",
						title: "Mandatory PDT",
						width: 150
					}, {
						field: "OtherPdt",
						title: "Other PDT",
						width: 100
					}, {
						field: "TimePdt",
						title: "PM/AM PDT",
						width: 100
					}, {
						field: "ProductionTarget",
						title: "Prod. Target",
						width: 120
					}, {
						field: "Remarks",
						title: "Remarks",
						width: 200,
						template: "<div class='customClass'> #= (Remarks == null) ? ' ' : kendo.toString(Remarks, '') # </div>",
					}, {
						title: "Created",
						columns: [
							{
								field: "CreatedBy",
								title: "By",
								width: 100
							},
							{
								field: "CreatedDate",
								title: "Date",
								width: 150,
								format: "{0:yyyy-MM-dd}"
							}]
					}, {
						title: "Updated",
						columns: [
							{
								field: "UpdatedBy",
								title: "By",
								width: 100
							},
							{
								field: "UpdatedDate",
								title: "Date",
								width: 150,
								format: "{0:yyyy-MM-dd}"
							}]
					}],
				toolbar: $("#template_toolbar").html(),
				dataBound: function(e) {
					o.initAfter();
				}
			});

			$("#fileUpload").kendoUpload({
				multiple: false,
				validation: {
					allowedExtensions: [".xls", ".xlsx"],
					maxFileSize: 5242880
				},
				select: function(e) {
					$.each(e.files, function (index, value) {
						if (value.extension.toLowerCase() !== ".xls" && value.extension.toLowerCase() !== ".xlsx") {
							e.preventDefault();
							swal.fire({ title: 'Invalid File', text: 'Please upload a valid Excel file (.xls or .xlsx)', icon: 'error' });
						}
						else if (value.size > 5242880) {
							e.preventDefault();
							swal.fire({ title: 'File Too Large', text: 'Excel file size cannot exceed 5MB.', icon: 'error' });
						}
					});
				}
			});

			$("#PeriodeUpload").kendoDatePicker({
				start: "year",
				depth: "year",
				format: "yyyy-MM"
			});
		},
		initAfter: function(){
			var o = this;
			if (o.initAfterCalled) return;
			o.initAfterCalled = true;
			o.dom.Prod_Date = $("#Prod_Date");

			o.dom.Prod_Date.kendoDatePicker({
				format: "yyyy-MM-dd",
				value: o.data.Prod_Date,
				change: function () {
					o.data.Prod_Date = this.value() != null ? this.value() : '';

					if(this.value()){
						o.dom.$grid.data('kendoGrid').dataSource.read();
					}
				}
			});
		}
	};

	$(function () {
		AppD.init();
	});
</script>

<script type="text/x-kendo-template" id="template_toolbar">
	<span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Additional Master Calendar -&nbsp;&nbsp;</span>
	<div class="toolbar">
		<button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
			<i class="k-icon k-i-excel"></i>
		</button>
		@if (Context.Session.GetString("add_AddMasterCalendar") == "True")
		{
			<button data-toggle="tooltip" title="Upload" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
				<i class="k-icon k-i-upload"></i>
			</button>
		}
	
		&nbsp;&nbsp;
		<input type="text" id="Prod_Date" placeholder="Select Period" style="width: 150px;" />
	</div>
</script>
