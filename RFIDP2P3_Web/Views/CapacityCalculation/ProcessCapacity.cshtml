@{
ViewData["Title"] = "Process";
string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<div class="page-main">
	<div class="page-content padding-5">
		<div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
	</div>
</div>

<script>
    var AppD = {
       attachEvents: function () {
          var o = this;
          o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
          o.dom.$grid.on('click', '#btnProcess', o.eventHandlers.onClickBtnProcess.bind(o));
          o.dom.$grid.on('click', '#btnReset', o.eventHandlers.onClickBtnReset.bind(o));
       },
       cacheDom: function () {
          var o = this;
          o.dom.$grid = $("#grid");
       },
       data: {
          Type: '1',
          Periode: kendo.toString(new Date(), "yyyyMM")
       },
       dom: {},
       eventHandlers: {
          onClickBtnExcel: function () {
             var o = this;
             o.dom.$grid.data('kendoGrid').saveAsExcel();
          },
          onClickBtnReset: function () {
             var o = this;

             swal.fire({
                title: 'Reset Calculation?',
                html: '<div style="margin-bottom:10px;">Select the period to reset:</div><input id="PeriodeReset" style="width:75%;" Placeholder="Select Period">',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Reset',
                cancelButtonText: 'Cancel',
                didOpen: () => {
                   var today = new Date();
                   var nextMonthDate = new Date(today.getFullYear(), today.getMonth() + 1, 1);

                   $("#PeriodeReset").kendoDatePicker({
                      format: "yyyy-MM", 
                      value: today,
                      //min: today,
                      start: "year",
                      depth: "year"
                   });

                   $("#PeriodeReset").attr("readonly", true);
                },
                preConfirm: () => {
                   var periodeDate = $("#PeriodeReset").data('kendoDatePicker').value();

                   if(!periodeDate) {
                      swal.showValidationMessage('Period is required.');
                      return false;
                   }

                   return kendo.toString(periodeDate, "yyyyMM");
                },
             }).then((result) => {
                if (result.isConfirmed) {
                   var periodStr = result.value;

                   $.ajax({
                      method: 'post',
                      headers: { 'Content-Type': 'application/json' },
                      url: "@myurl"+'ProcessCapacity/Reset',
                      dataType: 'text',
                      data: JSON.stringify({
                         Periode_ID: periodStr,
                         User_Login: "@Context.Session.GetString("PIC_ID")"
                      }),
                      beforeSend: function() {
                         swal.fire({
                            html: '<h5>Resetting data, please wait...</h5>',
                            showConfirmButton: false,
                            allowOutsideClick: false,
                            closeOnClickOutside: false,
                            didOpen: () => {
                               Swal.showLoading();
                            }
                         });
                      },
                   }).done(function( data, textStatus, jqXHR ) {
                      if(data !== 'success'){
                         swal.fire('Failed', data, 'error');
                         return;
                      }
                      swal.fire({ 
                         title: 'Success!', 
                         text: 'Calculation has been reset.',
                         icon: 'success', 
                         timer: 2000, 
                         showConfirmButton: false 
                      });
                      
                   }).fail(function( jqXHR, textStatus, errorThrown ) {
                      swal.fire('Error', errorThrown + (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
                   }).always(function(){
                      o.dom.$grid.data('kendoGrid').dataSource.read();
                   });
                }
             });
          },
          onClickBtnProcess: function () {
             var o = this;

             swal.fire({
                title: 'Process Calculation',
                html: '<div style="margin-bottom:10px;">Select the period to process:</div><input id="ProcessPeriode" style="width:75%;" Placeholder="Select Period">',
                icon: 'info',
                showCancelButton: true,
                confirmButtonText: 'Calculate',
                cancelButtonText: 'Cancel',
                didOpen: () => {
                   
                   var today = new Date();
                   var nextMonthDate = new Date(today.getFullYear(), today.getMonth() + 1, 1);

                   $("#ProcessPeriode").kendoDatePicker({
                      start: "year",
                      depth: "year",
                      format: "yyyy-MM",
                      value: today
                      //min: today
                   });
                   
                   $("#ProcessPeriode").attr("readonly", true);
                },
                preConfirm: () => {
                   var periodeDate = $("#ProcessPeriode").data('kendoDatePicker').value();

                   if (!periodeDate) {
                      swal.showValidationMessage('Period is required.');
                      return false;
                   }

                   return {
                      Periode_ID: kendo.toString(periodeDate, "yyyyMM")
                   };
                },
             }).then((result) => {
                if (result.isConfirmed) {
                   var payload = result.value;
                   payload.User_Login = "@Context.Session.GetString("PIC_ID")";

                   $.ajax({
                      method: 'post',
                      headers: { 'Content-Type': 'application/json' },
                      url: "@myurl"+'ProcessCapacity/Calc',
                      dataType: 'text',
                      data: JSON.stringify(payload),
                      beforeSend: function() {
                         swal.fire({
                            html: '<h5>Calculating, please wait...</h5>',
                            showConfirmButton: false,
                            allowOutsideClick: false,
                            closeOnClickOutside: false,
                            didOpen: () => {
                               Swal.showLoading();
                            }
                         });
                      },
                   }).done(function( data, textStatus, jqXHR ) {
                      if(data !== 'success'){
                         swal.fire('Failed', data, 'error');
                         return;
                      }
                      swal.fire({ 
                         title: 'Success!', 
                         text: 'Calculation completed successfully.', 
                         icon: 'success',
                         timer: 2000,
                         showConfirmButton: false 
                      });
                      
                   }).fail(function( jqXHR, textStatus, errorThrown ) {
                      swal.fire('Error', errorThrown + (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
                   }).always(function(){
                      o.dom.$grid.data('kendoGrid').dataSource.read();
                   });
                }
             });
          },
       },
       init: function () {
          var o = this;
          o.cacheDom();
          o.attachEvents();
          o.initElements();
       },
       initElements: function () {
          var o = this;

          o.dom.$grid.kendoGrid({
             excel: {
                fileName: "Process Capacity.xlsx",
                allPages: true,
                filterable: true
             },
             dataSource: {
                transport: {
                   read: function (options) {
                      $.ajax({
                         method: 'post',
                         headers: { 'Content-Type': 'application/json' },
                         url: "@myurl"+'ProcessCapacity/INQ',
                         dataType: 'text',
                         data: JSON.stringify({}) 
                      }).done(function (data, textStatus, jqXHR) {
                         try {
                            var result = JSON.parse(data);
                            options.success(result);
                         }
                         catch (e) {
                            swal.fire('Error', 'Failed to load grid data', 'error');
                            options.success({ data: [] });
                         }
                      }).fail(function (jqXHR, textStatus, errorThrown) {
                         swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
                         options.success({ data: [] });
                      });
                   }
                },
                schema: {
                   model: {
                      fields: {
                         Calc_Status: { type: "string" },
                         Error_Message: { type: "string" },
                         Periode_ID: { type: "string" },
                         Calc_Date: { type: "date" },
                         Calc_By: { type: "string" }
                      }
                   }
                },
                pageSize: 20
             },
             scrollable: true,
             sortable: true,
             resizable: true,
             reorderable: true,
             filterable: {
                extra: false,
                operators: {
                   string: {
                      contains: "Contains",
                      eq: "Equal to",
                      neq: "Not equal to"
                   }
                }
             },
             pageable: {
                refresh: true,
                input: true,
                numeric: true,
                pageSizes: true,
                buttonCount: 5
             },
             columns: [
                {
                   field: "Periode_ID",
                   title: "Period",
                   width: 100
                }, {
                   field: "Calc_Status",
                   title: "Status",
                   width: 100,
                }, {
                   field: "Error_Message",
                   title: "Error Message",
                   width: 200,
                   template: "<div class='customClass'> #= (Error_Message == null) ? ' ' : kendo.toString(Error_Message, '') # </div>",
                }, {
                   title: "Calculation Details",
                   columns: [
                      {
                         field: "Calc_By",
                         title: "User",
                         width: 100
                      }, {
                         field: "Calc_Date",
                         title: "Date",
                         width: 150,
                         template: "<div class='customClass'> #= (Calc_Date == null) ? ' ' : kendo.toString(kendo.parseDate(Calc_Date), 'dd/MM/yyyy HH:mm:ss') # </div>",
                      }]
                }],
             toolbar: $("#template_toolbar").html(),
             dataBound: function(e) {
                var rows = this.tbody.find("tr");
                rows.each(function() {
                   var dataItem = e.sender.dataItem(this);
                   if (dataItem.Calc_Status === "Error") {
                      $(this).css("background-color", "#ff9999");
                   }
                });
             }
          });
       }
    };

    $(function () {
       AppD.init();
    });
</script>

<script type="text/x-kendo-template" id="template_toolbar">
	<span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Process Calculation -&nbsp;&nbsp;</span>
	<div class="toolbar">
		<button data-toggle="tooltip" title="Save to Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
			<i class="k-icon k-i-excel"></i>
		</button>
		@if (Context.Session.GetString("add_ProcessCapacity") == "True")
		{
		<button data-toggle="tooltip" title="Process Calculation" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnProcess">
			<i class="fa fa-calculator"></i>
		</button>
		}
		@if (Context.Session.GetString("del_ProcessCapacity") == "True")
		{
		<button data-toggle="tooltip" title="Reset Data" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnReset">
			<i class="fa fa-trash"></i>
		</button>
		}
	</div>
</script>