@{
    ViewData["Title"] = "Parameter Capacity";
    string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}

<div class="page-main">
    <div class="page-content padding-10">
        <button type="button" id="btnLoad" class="btn btn-primary" style="display:none;">Load</button>
        <div id="grid" style="margin-top:5px; margin-bottom:5px;"></div>
    </div>
</div>

<div class="modal fade modal-primary" id="editorUpload" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" style="padding-top:25vh;">
    <div class="" role="document" style="padding-left:25vw;">
        <div class="modal-content" style="width:50vw">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="myModalTitle">Upload Parameter Capacity</h4>
            </div>
            <div class="modal-body margin-bottom-0 padding-bottom-0">
                <form id="formUpload" enctype="multipart/form-data" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 control-label" style="text-align:left;">Periode</label>
                        <div class="col-sm-9">
                            <input type="text" id="PeriodeUpload" style="width: 100%;" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label" style="text-align:left;">File Excel</label>
                        <div class="col-sm-9">
                            <input type="file" name="file" id="fileUpload" accept=".xls,.xlsx" />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-12">
                            <span>Download template <a href="#" id="btnDownloadTemplate" style="color:#0099ff">here</a></span>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id='clear'>Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveUpload">Upload</button>
            </div>
        </div>
    </div>
</div>

<script>
    var AppD = {
        attachEvents: function () {
            var o = this;
            o.dom.$btnSaveUpload.on('click', o.eventHandlers.onClickBtnSaveUpload.bind(o));
            o.dom.$grid.on('click', '#btnUpload', o.eventHandlers.onClickBtnUpload.bind(o));
            o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
            o.dom.$editorUpload.on('click', '#btnDownloadTemplate', o.eventHandlers.onClickBtnDownloadTemplate.bind(o));
        },
        cacheDom: function () {
            var o = this;
            o.dom.$grid = $("#grid");
            o.dom.$editorUpload = $("#editorUpload");
            o.dom.$btnSaveUpload = $("#btnSaveUpload");
        },
        data: {
            UploadDate: new Date()
        },
        dom: {},
        eventHandlers: {
            onClickBtnExcel: function () {
                var o = this;
                o.dom.$grid.data('kendoGrid').saveAsExcel();
            },
            onClickBtnUpload: function () {
                var o = this;
                var upload = $("#fileUpload").data('kendoUpload');
                if(upload) upload.clearAllFiles();

                var dpUpload = $("#PeriodeUpload").data("kendoDatePicker");
                if (dpUpload) {
                    var today = new Date();
                    dpUpload.value(today);
                }
                o.dom.$editorUpload.modal('show');
            },
            onClickBtnDownloadTemplate: function (e) {
                e.preventDefault();
                var dpPeriode = $("#PeriodeUpload").data("kendoDatePicker");
                var selectedDateValue = dpPeriode.value();

                if (!selectedDateValue) {
                    swal.fire('Warning', 'Please select a period first.', 'warning');
                    return;
                }

                var selectedMonth = kendo.toString(selectedDateValue, 'yyyy-MM');
                swal.fire({
                    title: 'Generating Template...',
                    allowOutsideClick: false,
                    didOpen: () => { swal.showLoading() }
                });

                fetch("/ApiProxy/Forward/ParameterCapacity/DownloadTemplate?periode=" + selectedMonth, {
                    method: 'GET',
                }).then(async response => {
                    if (!response.ok) {
                        let errorText = await response.text();
                        throw new Error(errorText);
                    }
                    return response.blob();
                }).then(blob => {
                    swal.close();
                    var url = window.URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url;
                    a.download = "Template_ParameterCapacity_" + selectedMonth + ".xlsx";
                    a.click();
                }).catch(error => {
                    swal.close();
                    swal.fire('Download Failed', error.message, 'error');
                });
            },
            onClickBtnSaveUpload: function () {
                var o = this;
                let files = $("#fileUpload").data('kendoUpload').getFiles();
                if (files.length === 0) {
                    swal.fire('Warning', 'Please select a file to upload.', 'warning');
                    return;
                }

                swal.fire({
                    title: 'Upload Parameter Capacity?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Upload',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        swal.fire({
                            title: 'Uploading...',
                            text: 'Please wait while the system processes the data.',
                            allowOutsideClick: false,
                            didOpen: () => { swal.showLoading(); }
                        });

                        let formData = new FormData();
                        let file = files[0].rawFile;
                        formData.append('file', file);

                        $.ajax({
                            url: "@myurl" + "ParameterCapacity/Upload?UID=" + "@Context.Session.GetString("PIC_ID")",
                            type: 'post',
                            data: formData,
                            contentType: false,
                            processData: false
                        }).done(function (data, textStatus, jqXHR) {
                            o.dom.$editorUpload.modal('hide');
                            swal.fire({
                                title: 'Success!',
                                text: 'Data has been successfully uploaded.',
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false
                            });

                            $("#fileUpload").data('kendoUpload').clearAllFiles();
                            o.dom.$grid.data('kendoGrid').dataSource.read();
                        }).fail(function (jqXHR, textStatus, errorThrown) {
                            swal.fire({
                                title: 'Upload Failed',
                                html: jqXHR.responseText,
                                icon: 'error',
                                width: '600px'
                            });
                        }).always(function () {
                            $("#fileUpload").data('kendoUpload').clearAllFiles();
                        });
                    }
                });
            }
        },
        init: function () {
            var o = this;
            o.cacheDom();
            o.attachEvents();
            o.initElements();
        },
        initElements: function () {
            var o = this;

            o.dom.$grid.kendoGrid({
                excel: {
                    fileName: "Parameter Capacity.xlsx",
                    allPages: true,
                    filterable: false
                },
                dataSource: {
                    transport: {
                        read: function (options) {
                            $.ajax({
                                method: 'post',
                                headers: { 'Content-Type': 'application/json' },
                                url: "@myurl"+'ParameterCapacity/INQ',
                                dataType: 'text',
                                data: JSON.stringify({
                                    UploadDate: kendo.toString(o.data.UploadDate, 'yyyyMM')
                                })
                            }).done(function (data, textStatus, jqXHR) {
                                try {
                                    var rawResult = JSON.parse(data);

                                    var grouped = {};
                                    rawResult.forEach(function(item) {
                                        if (!grouped[item.LineCode]) grouped[item.LineCode] = [];
                                        grouped[item.LineCode].push(item);
                                    });

                                    var pivotedResult = [];
                                    for (var lineCode in grouped) {
                                        var items = grouped[lineCode].sort(function(a, b) {
                                            return String(a.Month).localeCompare(String(b.Month));
                                        });

                                        var advRow = { LineCode: lineCode, Parameter: "Advance", N: null, N_1: null, N_2: null, N_3: null };
                                        var manRow = { LineCode: lineCode, Parameter: "Mandatory", N: null, N_1: null, N_2: null, N_3: null };
                                        var hotRow = { LineCode: lineCode, Parameter: "Overtime HOT", N: null, N_1: null, N_2: null, N_3: null };

                                        items.forEach(function(item, index) {
                                            var mField = index === 0 ? "N" : "N_" + index;
                                            if (index <= 3) {
                                                advRow[mField] = item.Advance;
                                                manRow[mField] = item.Mandatory;
                                                hotRow[mField] = item.OvertimeHOT;
                                            }
                                        });

                                        pivotedResult.push(advRow, manRow, hotRow);
                                    }
                                    
                                    options.success(pivotedResult);
                                }
                                catch (e) {
                                    swal.fire('Error', 'Failed to parse grid data', 'error');
                                    options.success({ data: [] });
                                }
                            }).fail(function (jqXHR, textStatus, errorThrown) {
                                swal.fire('Error', (jqXHR.responseText !== '' ? ': ' + jqXHR.responseText : ''), 'error');
                                options.success({ data: [] });
                            });
                        }
                    },
                    schema: {
                        model: {
                            id: "LineCode",
                            fields: {
                                LineCode: { type: "string" },
                                Parameter: { type: "string" },
                                N: { type: "number" },
                                N_1: { type: "number" },
                                N_2: { type: "number" },
                                N_3: { type: "number" }
                            }
                        }
                    },
                    pageSize: 30
                },
                scrollable: true,
                sortable: true,
                resizable: true,
                reorderable: true,
                filterable: {
                    extra: false,
                    operators: {
                        string: {
                            contains: "Contains",
                            eq: "Equal to",
                            neq: "Not equal to"
                        }
                    }
                },
                pageable: {
                    refresh: true,
                    input: true,
                    numeric: true,
                    pageSizes: true,
                    buttonCount: 5
                },
                columns: [
                    { field: "LineCode", title: "Line", width: 80 },
                    { field: "Parameter", title: "Parameter", width: 150 },
                    { field: "N", title: "N", width: 80, attributes: { style: "text-align: center;" } },
                    { field: "N_1", title: "N+1", width: 80, attributes: { style: "text-align: center;" } },
                    { field: "N_2", title: "N+2", width: 80, attributes: { style: "text-align: center;" } },
                    { field: "N_3", title: "N+3", width: 80, attributes: { style: "text-align: center;" } }
                ],
                toolbar: $("#template_toolbar").html(),
                dataBound: function(e) {
                    var grid = this;
                    var rows = grid.tbody.find("tr[role='row']");

                    // --- ROWSPAN LOGIC ---
                    var previousRow = null;
                    var rowspan = 1;

                    for (var i = 0; i < rows.length; i++) {
                        var row = $(rows[i]);
                        var cell = row.children().eq(0); // Sel LineCode

                        if (previousRow && cell.text() === previousRow.children().eq(0).text()) {
                            cell.hide();
                            rowspan++;
                            previousRow.children().eq(0).attr("rowspan", rowspan);
                        } else {
                            previousRow = row;
                            rowspan = 1;
                        }
                    }

                    o.initAfter();
                }
            });
        },
        initAfter: function () {
            var o = this;

            if (!$("#fileUpload").data("kendoUpload")) {
                $("#fileUpload").kendoUpload({
                    multiple: false,
                    validation: {
                        allowedExtensions: [".xls", ".xlsx"],
                        maxFileSize: 5242880
                    },
                    select: function(e) {
                        $.each(e.files, function (index, value) {
                            if (value.extension.toLowerCase() !== ".xls" && value.extension.toLowerCase() !== ".xlsx") {
                                e.preventDefault();
                                swal.fire({ title: 'Invalid File', text: 'Please upload a valid Excel file (.xls or .xlsx)', icon: 'error' });
                            }
                            else if (value.size > 5242880) {
                                e.preventDefault();
                                swal.fire({ title: 'File Too Large', text: 'Excel file size cannot exceed 5MB.', icon: 'error' });
                            }
                        });
                    }
                });
            }

            var today = new Date();

            if (!$("#PeriodeUpload").data("kendoDatePicker")) {
                $("#PeriodeUpload").kendoDatePicker({
                    start: "year",
                    depth: "year",
                    format: "yyyy-MM",
                    value: today
                });
                $("#PeriodeUpload").attr("readonly", true);
            }

            if (!$("#UploadDate").data("kendoDatePicker")) {
                $("#UploadDate").kendoDatePicker({
                    start: "year",
                    depth: "year",
                    format: "yyyy-MM",
                    value: o.data.UploadDate,
                    change: function() {
                        o.data.UploadDate = this.value();

                        if(typeof o.dom.$grid.data('kendoGrid') != 'undefined') {
                            o.dom.$grid.data('kendoGrid').dataSource.read();
                        }
                    }
                });
                $("#UploadDate").attr("readonly", true);
            }
        }
    };

    $(function () {
        AppD.init();
    });
</script>

<script type="text/x-kendo-template" id="template_toolbar">
    <span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Parameter Capacity -&nbsp;&nbsp;</span>
    <div class="toolbar">
        <button data-toggle="tooltip" title="Save to Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
            <i class="k-icon k-i-excel"></i>
        </button>
        @if (Context.Session.GetString("add_ParameterCapacity") == "True")
        {
        <button data-toggle="tooltip" title="Upload" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnUpload">
            <i class="k-icon k-i-upload"></i>
        </button>
        }

        &nbsp;&nbsp;
        <input type="date" id="UploadDate" placeholder="Select Period" style="width: 150px;"/>
        &nbsp;&nbsp;
    </div>
</script>