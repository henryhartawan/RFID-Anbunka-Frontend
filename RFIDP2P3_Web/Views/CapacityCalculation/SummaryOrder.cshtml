@{
    ViewData["Title"] = "Summary Order";
    string myurl = new ConfigurationBuilder().AddJsonFile("appsettings.json").Build().GetSection("Path:URL").Value;
}
<style>
    .page-content {
       display: block;
    }
    #grid {
       width: 100%;
       min-height: 350px;
    }
</style>

<div class="page-main">
    <div class="page-content padding-10">
       <button type="button" id="btnLoad" class="btn btn-primary" style="display:none;">Load</button>
       
       <div id="grid"></div>
    </div>
</div>

<script>
    var AppD = {
       attachEvents: function () {
          var o = this;
          o.dom.$grid.on('click', '#btnExcel', o.eventHandlers.onClickBtnExcel.bind(o));
          o.dom.$btnLoad.on('click', o.eventHandlers.onClickBtnLoad.bind(o));
       },
       cacheDom: function () {
          var o = this;
          o.dom.$grid = $("#grid");
          o.dom.$btnLoad = $("#btnLoad");
       },
       data: {
          UploadDate: new Date(),
       },
       dom: {},
       eventHandlers: {
          onClickBtnExcel: function () {
             var o = this;
             o.dom.$grid.data('kendoGrid').saveAsExcel();
          },
          onClickBtnLoad: function(){
             var o = this;
             
             $.ajax({
                method: 'post',
                headers: { 'Content-Type': 'application/json' },
                url: "@myurl" + 'SummaryOrder/INQ',
                dataType: 'json',
                data: JSON.stringify({
                   UploadDate: kendo.toString(o.data.UploadDate, 'yyyyMM')
                })
             }).done(function (data) {
                var isEmpty = (!data || data.length === 0);

                if (isEmpty) {
                   swal.fire('Info', 'Tidak ada data pada periode tersebut', 'info');
                   data = [];
                }

                if (typeof o.dom.$grid.data('kendoGrid') != 'undefined') {
                   o.dom.$grid.data('kendoGrid').destroy();
                   o.dom.$grid.empty();
                }

                var result = [];
                if(!isEmpty){
                   data.forEach(function(row) {
                      var newRow = {};
                      for(var k in row) {
                         if(row.hasOwnProperty(k)) {
                            var safeKey = k.replace(/\+/g, '_plus_').replace(/\-/g, '_min_').replace(/\s/g, '_');
                            newRow[safeKey] = row[k];
                         }
                      }
                      result.push(newRow);
                   });
                }

                var schemaFields = {
                   GroupOrder: {type: "number"},
                   OrderFrom: {type: "string"},
                   EngineGrouping: {type: "string"},
                   EngineBase: {type: "string"}
                };

                var columns = [
                   {
                      field: "GroupOrder",
                      hidden: true,
                      groupHeaderTemplate: function(e) {
                         var orderFrom = e.items && e.items.length > 0 ? e.items[0].OrderFrom : '';
                         if(orderFrom === 'RESUME ENGINE') {
                            return "<span style='color: rgb(56, 118, 29); font-weight: bold; font-size: 14px;'>Resume Engine</span>";
                         }
                         return orderFrom;
                      }
                   },
                   { field: "OrderFrom", hidden: true },
                   { field: "EngineGrouping", title: "Engine Assy/Vehicle", width: 200 },
                   { field: "EngineBase", title: "EG Base", width: 100 }
                ];

                var aggregateConfig = [];
                var periodeStr = kendo.toString(o.data.UploadDate, 'yyyyMM');
                var pYear = parseInt(periodeStr.substring(0, 4));
                var pMonth = parseInt(periodeStr.substring(4, 6));

                if(!isEmpty) {
                   for(var originalKey in data[0]){
                      if(data[0].hasOwnProperty(originalKey)){
                         if(['GroupOrder', 'OrderFrom', 'EngineGrouping', 'EngineBase'].indexOf(originalKey) >= 0){
                            continue;
                         }

                         var safeKey = originalKey.replace(/\+/g, '_plus_').replace(/\-/g, '_min_').replace(/\s/g, '_');

                         var offset = 0;
                         if(originalKey.indexOf('+') > -1) offset = parseInt(originalKey.split('+')[1]);
                         else if(originalKey.indexOf('-') > -1) offset = -parseInt(originalKey.split('-')[1]);

                         var d = new Date(pYear, pMonth + offset, 1);
                         var monthName = kendo.toString(d, "MMMM");

                         var finalTitle = originalKey + " <br/> (" + monthName + ")";

                         schemaFields[safeKey] = {type: 'number'};
                         aggregateConfig.push({ field: safeKey, aggregate: "sum" });

                         columns.push({
                            field: safeKey,
                            title: finalTitle,
                            width: 100,
                            attributes: { style: "text-align: right;" },
                            headerAttributes: { style: "text-align: right;" },
                            aggregates: ["sum"],
                            groupFooterTemplate: "<div style='text-align:right'>#=sum#</div>",
                            footerTemplate: "<div style='text-align:right'><strong>#= sum / 2 #</strong></div>"
                         });
                      }
                   }
                }

                o.dom.$grid.kendoGrid({
                   excel: {
                      fileName: "Summary Order.xlsx",
                      allPages: true,
                      filterable: true
                   },

                   excelExport: function(e) {
                      var sheet = e.workbook.sheets[0];

                      for (var i = 0; i < sheet.rows.length; i++) {
                         var row = sheet.rows[i];

                         for (var j = 0; j < row.cells.length; j++) {
                            var cell = row.cells[j];

                            if (cell.value && typeof cell.value === "string") {
                               cell.value = cell.value.replace(/<br\s*[\/]?>/gi, "\n");
                               cell.value = cell.value.replace(/<\/?[^>]+(>|$)/g, "");
                               cell.value = cell.value.trim();

                               if (!isNaN(cell.value) && cell.value !== "") {
                                  cell.value = Number(cell.value);
                               }
                               else if (typeof cell.value === "string" && cell.value.indexOf("\n") >= 0) {
                                  cell.wrap = true;
                               }
                            }
                         }
                      }
                   },
                   
                   dataSource: {
                      data: result,
                      schema: {
                         model: { fields: schemaFields }
                      },
                      group: {
                         field: "GroupOrder",
                         aggregates: aggregateConfig
                      },
                      aggregate: aggregateConfig,
                      pageSize: 20
                   },
                   scrollable: true,
                   sortable: true,
                   resizable: true,
                   reorderable: true,
                   filterable: {
                      extra: false,
                      operators: {
                         string: {
                            contains: "Contains",
                            eq: "Equal to",
                            neq: "Not equal to"
                         }
                      }
                   },
                   pageable: {
                      refresh: true,
                      input: true,
                      numeric: true,
                      pageSizes: true,
                      buttonCount: 5
                   },
                   columns: columns,
                   toolbar: $("#template_toolbar").html(),
                   dataBound: function(e) {
                      o.initAfter();

                      var grid = e.sender;
                      grid.tbody.find("tr.k-grouping-row").each(function () {
                         if ($(this).text().indexOf("RESUME ENGINE") > -1) {
                            $(this).css("background-color", "rgb(226, 240, 217)");
                            $(this).nextUntil(".k-grouping-row").css("background-color", "rgb(226, 240, 217)");
                         }
                      });
                   }
                });
                
             }).fail(function (jqXHR) {
                swal.fire('Error', 'Gagal meload data summary.', 'error');
             });
          }
       },
       init: function () {
          var o = this;
          o.cacheDom();
          o.attachEvents();
          o.initElements();
       },
       initElements: function () {
          var o = this;
          o.dom.$btnLoad.click();
       },
       initAfter: function () {
          var o = this;
          o.dom.UploadDate = $("#UploadDate");

          if(!o.dom.UploadDate.data("kendoDatePicker")) {
             o.dom.UploadDate.kendoDatePicker({
                start: "year",
                depth: "year",
                format: 'yyyyMM',
                value: o.data.UploadDate,
                change: function () {
                   o.data.UploadDate = this.value() != null ? this.value() : '';

                   if(this.value()){
                      o.dom.$btnLoad.click();
                   }
                }
             });
          }
       }
    };

    $(function () {
       AppD.init();
    });
</script>

<script type="text/x-kendo-template" id="template_toolbar">
    <span class="k-pager-refresh" style="font-weight: bold">&nbsp;&nbsp;- Summary Order -&nbsp;&nbsp;</span>
    <div class="toolbar">
        <button data-toggle="tooltip" title="Save as Excel" type="button" class="btn ink-reaction btn-floating-action btn-xs btn-warning" id="btnExcel">
            <i class="k-icon k-i-excel"></i>
        </button>
        &nbsp;&nbsp;
        <input type="date" id="UploadDate" placeholder="Periode" />
    </div>
</script>